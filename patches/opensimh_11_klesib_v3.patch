+/* SET SOUND ENABLED: an enabled TB must have TU81 drives */
+
+static t_stat tb_rlz_enable_check (void)
+{
+if ((tq_ctx1.dev != NULL) && !(tq_ctx1.dev->flags & DEV_DIS) && (tq_ctx1.typ != TQ8_TYPE))
+    return tb_rlz_msg ("SET SOUND ENABLED: ", tq_ctx1.typ);
+return SCPE_OK;
+}
+
+/* Realism mode: an enabled TB is a TU81 (SET TB ENABLE after a SET TB
+   TK50/TK70/user type made while TB was disabled).  Units are never
+   attached here with another type (ATTACH refuses it). */
+
+static void tb_rlz_force_tu81 (DEVICE *dptr)
+{
+uint32 i;
+
+if ((dptr->flags & DEV_DIS) || !sim_sound_enabled () ||
+    !tq_ctx1.inited || (tq_ctx1.typ == TQ8_TYPE))
+    return;
+sim_printf ("TB: realism mode: %s replaced by TU81 (a KLESI-B connects TU81 drives only)\n",
+            drv_tab[tq_ctx1.typ].name);
+tq_ctx1.typ = TQ8_TYPE;
+for (i = 0; i < dptr->numunits; i++)
+    dptr->units[i].capac = drv_tab[TQ8_TYPE].cap;
+}
+
+t_stat tb_reset (DEVICE *dptr)
+{
+sim_sound_register_enable_check (&tb_rlz_enable_check);    /* realism: TU81 only */
+if (!tq_ctx1.inited) {                                  /* the adapter's hooks */
+    tq_ctx1.rb = &kb_rb;
+    tq_ctx1.rw = &kb_rw;
+    tq_ctx1.wb = &kb_wb;
+    tq_ctx1.ww = &kb_ww;
+    tq_ctx1.setint = &kb_setint;
+    tq_ctx1.clrint = &kb_clrint;
+    tq_ctx_init (&tq_ctx1, dptr, TQ8_TYPE, TRUE);
+    }
+tb_rlz_force_tu81 (dptr);                               /* realism: TU81 only */
+kb_reset (dptr);
+return tq_reset (dptr);
+}
+
+t_stat tb_help (FILE *st, DEVICE *dptr, UNIT *uptr, int32 flag, const char *cptr)
+{
+fprintf (st, "KLESI-B VAXBI Tape Adapter (TB)\n\n");
+fprintf (st, "The KLESI-B is a VAXBI node with a TMSCP port (KLESI) on an internal\n");
+fprintf (st, "Unibus, for up to four TU81 tape drives (units TB0 to TB3).  It is a\n");
+fprintf (st, "second TMSCP tape controller next to TQ (TUK50, TU81 on the DWBUA's\n");
+fprintf (st, "Unibus) and works without the DWBUA, so also in the VAXBI-only mode\n");
+fprintf (st, "(SET UBA DISABLE).  TB is disabled by default:\n\n");
+fprintf (st, "    SET TB ENABLE\n");
+fprintf (st, "    SET TB NODE=8          VAXBI node (2-15, default 8)\n");
+fprintf (st, "    ATTACH TB0 tape.tap\n\n");
+fprintf (st, "The adapter has the DWBUA's registers (vector offset, map registers);\n");
+fprintf (st, "the port's IP and SA registers are at Unibus address 774500 in the\n");
+fprintf (st, "node's window.  ULTRIX supports it (V2.0: bla.c, tmscp.c).\n\n");
+fprintf (st, "SIMH also accepts SET TB TK50, TK70 or TKUSER (the guest only sees\n");
+fprintf (st, "TMSCP); no KLESI adapter ever connected those drives, so the sound\n");
+fprintf (st, "realism mode (SET SOUND ENABLED) allows the TU81 only.\n\n");
+fprint_set_help (st, dptr);
+fprint_show_help (st, dptr);
+fprint_reg_help (st, dptr);
+return SCPE_OK;
+}
+
+const char *tb_description (DEVICE *dptr)
+{
+return "KLESI-B VAXBI TMSCP tape adapter";
+}
