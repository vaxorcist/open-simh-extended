From f7ef808a920c44a9eb325b6bb932cc8871ea7266 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 21:51:45 +0100
Subject: [PATCH 1/5] DUP: DEC mode with CRC inhibit appends no CRC (known
 issue 124)

The DUP11 sends the CRC check character at the end of a DDCMP message only
when CRC is not inhibited (User's Manual, TXCSR SEND/TEOM).  With PARCSR
CRC inhibit the program supplies the CRCs itself (DEC's DUP11 loader
SECDUP.SYS does so); SIMH appended its own CRC anyway.  Now no CRC is
appended and the message ends at the length its DDCMP header gives, so
trailing sync fill is dropped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SuavtcpUxEC2vXhit3JaAg
---
 PDP11/pdp11_dup.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/PDP11/pdp11_dup.c b/PDP11/pdp11_dup.c
index 225f34f0..e7608a30 100644
--- a/PDP11/pdp11_dup.c
+++ b/PDP11/pdp11_dup.c
@@ -36,6 +36,8 @@
    characters both initially and between DDCMP packets.
 
    15-May-13    MP      Initial implementation
+   25-Nov-26    Ulli    DEC mode with CRC inhibit: no CRC appended, the message
+                        ends at its DDCMP header count (known issue 124)
 
 */
 
@@ -1244,6 +1246,28 @@ if (!tmxr_tpbusyln(&dup_ldsc[dup])) {  /* Not Busy sending? */
     if (end) {
         uint16 crc16;
 
+        if (charmode && UNIBUS && (dup_parcsr[dup] & PARCSR_M_NOCRC)) {
+            /* CRC inhibited: the program sent the CRCs itself; the message
+               ends where its DDCMP header says (drop trailing sync fill) */
+            uint8 *msg = dup_xmtpacket[dup];
+            uint16 msglen = dup_xmtpkoffset[dup];
+
+            if ((msglen >= 8) && (msg[0] == DDCMP_ENQ))
+                msglen = 8;
+            else
+                if ((msglen >= 8) && ((msg[0] == DDCMP_SOH) || (msg[0] == DDCMP_DLE))) {
+                    uint16 count = (msg[1] | (msg[2] << 8)) & 0x3FFF;
+
+                    if (msglen > 8 + count + 2)
+                        msglen = 8 + count + 2;
+                    }
+            dup_xmtpkoffset[dup] = msglen;
+            if (msglen >= 8) {
+                dup_xmtpkbytes[dup] = msglen;
+                ddcmp_tmxr_put_packet_ln (&dup_ldsc[dup], msg, dup_xmtpkbytes[dup], dup_corruption[dup]);
+                }
+            }
+        else
         if (charmode) {
             crc16 = ddcmp_crc16 (0, dup_xmtpacket[dup], dup_xmtpkoffset[dup]);
             dup_xmtpacket[dup][dup_xmtpkoffset[dup]++] = crc16 & 0xFF;
-- 
