+#define DMVB_START          4       /* start trap requested; vector words go back next */
+#define DMVB_HOW_POWERON    1       /* BOOT DMVn (power-on boot, E101 SW4) */
+#define DMVB_HOW_REMOTE     2       /* remote load detect (E101 SW5) */
+#define DMVB_HOW_INVOKE     3       /* invoke primary MOP (BSEL1 bits 5 and 6) */
