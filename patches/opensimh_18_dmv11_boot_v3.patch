+for (sw = 0; sw < 10; sw++)
+    fprintf (st, " %s", (e101 & (1 << sw)) ? "OFF" : "ON");
+fprintf (st, "\n  SW1    mode enable          %s\n", (e101 & DMV_E101_MODE_ENABLE) ?
+             "OFF: mode from SW6-8" : "ON:  mode set by software");
+fprintf (st, "  SW2    unit for booting     %s\n", (e101 & DMV_E101_UNIT1) ? "OFF: unit 1" : "ON:  unit 0");
+fprintf (st, "  SW3    auto answer          %s (no effect in the simulation)\n", (e101 & DMV_E101_AUTOANSWER) ? "OFF" : "ON");
+fprintf (st, "  SW4    power-on boot        %s\n", (e101 & DMV_E101_POWERON) ? "OFF: enabled" : "ON:  disabled");
+fprintf (st, "  SW5    remote load detect   %s\n", (e101 & DMV_E101_REMOTELOAD) ? "OFF: enabled" : "ON:  disabled");
+fprintf (st, "  SW6-8  mode                 %s %s %s: %s%s\n",
+             (e101 & (1 << 5)) ? "OFF" : "ON", (e101 & (1 << 6)) ? "OFF" : "ON", (e101 & (1 << 7)) ? "OFF" : "ON",
+             dmv_mode_names[(e101 & DMV_E101_M_MODE) >> DMV_E101_V_MODE],
+             (e101 & DMV_E101_MODE_ENABLE) ? "" : " (not used: SW1 ON)");
+fprintf (st, "  SW9    high speed           %s (no effect in the simulation)\n", (e101 & DMV_E101_HIGHSPEED) ? "OFF" : "ON");
+fprintf (st, "  SW10   interface select     %s (no effect in the simulation)\n", (e101 & DMV_E101_V35) ? "OFF" : "ON");
+fprintf (st, "switch pack E113 (M8053; E119 on the M8064), tributary address/password, SW1-SW8:");
+for (sw = 0; sw < 8; sw++)
+    fprintf (st, " %s", (dmv_e113[ln] & (1 << sw)) ? "OFF" : "ON");
+fprintf (st, "\n  value %d (%03o octal)\n", dmv_e113[ln], dmv_e113[ln]);
+if (DMV_BOOT_SUPPORTED)
+    fprintf (st, "program requested at boot (simulator setting, not a switch): %s\n",
+             dmv_program_names[dmv_program[ln] % 3]);
+controller = (CTLR *)uptr->ctlr;
+fprintf (st, "boot: %s\n", DMV_BOOT_SUPPORTED ? ((controller && (controller->dmv_boot.state <= DMVB_START)) ?
+                                                boot_states[controller->dmv_boot.state] : "none")
+                                            : "not available (PDP-11 simulator only)");
+return SCPE_OK;
+}
+
+/* Why a remote station's boot cannot work, NULL if it can */
+static const char *dmv_boot_refused (CTLR *controller)
+{
+if (!DMV_BOOT_SUPPORTED)
+    return "The DMV11 boot functions are only available in the PDP-11 simulator";
+if (!dmv_mode_from_switches(controller))
+    return "Booting needs the station mode set by the mode switches (SET DMVn MODE=...)";
+if ((dmv_switch_mode(controller) & 6) == 4)
+    return "A multipoint control station is not booted (MODE=HDXCONTROL or FDXCONTROL)";
+return NULL;
+}
+
+t_bool dmv_boot_active (CTLR *controller)
+{
+return controller->dmv_boot.state != DMVB_IDLE;
+}
+
+void dmv_boot_cancel (CTLR *controller)
+{
+controller->dmv_boot.state = DMVB_IDLE;
+controller->dmv_held_valid = FALSE;
+}
+
+/* Send a MOP message in a DDCMP maintenance message with the boot address
+   (the select flag returns the line to a multipoint control station).  It
+   is kept for retransmission. */
+static void dmv_boot_send (CTLR *controller, const uint8 *mop, size_t len)
+{
+uint8 pkt[DDCMP_HEADER_SIZE + sizeof(controller->dmv_boot.last) + DDCMP_CRC_SIZE];
+
+if (mop != controller->dmv_boot.last) {
+    memcpy (controller->dmv_boot.last, mop, len);
+    controller->dmv_boot.last_len = len;
+    }
+ddcmp_build_maintenance_packet (pkt, len);
+pkt[5] = controller->dmv_boot.address;
+memcpy (pkt + DDCMP_HEADER_SIZE, controller->dmv_boot.last, len);
+controller->dmv_boot.last_time = sim_os_msec();
+controller->dmv_boot.last_unsent =
+    (ddcmp_tmxr_put_packet_crc_ln (controller->line, pkt, DDCMP_HEADER_SIZE + len + DDCMP_CRC_SIZE, 0) != SCPE_OK);
+sim_debug(DBG_INF, controller->device, "%s%d: Boot: MOP message %d sent%s\n", controller->device->name,
+          controller->index, mop[0], controller->dmv_boot.last_unsent ? " (line busy or down: again later)" : "");
+}
+
+static void dmv_boot_request_program (CTLR *controller)
+{
+/* code, device type, format version 1, program type (SET DMVn PROGRAM:
+   0 secondary loader, 1 tertiary loader, 2 system image) */
+uint8 request[4] = {DMV_MOP_REQ_PROGRAM, DMV_MOP_DEVTYPE, 1, 0};
+
+request[3] = dmv_program[dmv_line(controller)];
+
+controller->dmv_boot.state = DMVB_REQUEST;
+dmv_boot_send (controller, request, sizeof(request));
+}
+
+static void dmv_boot_request_load (CTLR *controller, uint8 loadnum, uint8 error)
+{
+uint8 request[3];
+
+request[0] = DMV_MOP_REQ_LOAD;
+request[1] = loadnum;
+request[2] = error;
+controller->dmv_boot.state = DMVB_LOADING;
+dmv_boot_send (controller, request, sizeof(request));
+}
+
+/* Take the CPU over: the waiting routine at 40, entered through the
+   power-fail/restart vector 24 at priority 7.  trap: through a power-fail
+   trap with memory management switched off (as after a power-up), else
+   (BOOT command) as the CPU's start address. */
+static void dmv_park_cpu (CTLR *controller, t_bool trap)
+{
+#if DMV_BOOT_SUPPORTED
+static const uint16 park[4] = {
+    0012706, DMV_PARK_SP,           /* MOV #1000,SP */
+    0000001,                        /* WAIT */
+    0000776 };                      /* BR .-2 */
+uint16 vector[2];
+
+vector[0] = DMV_PARK;
+vector[1] = 0000340;
+Map_WriteW (DMV_PARK, sizeof(park), park);
+Map_WriteW (VEC_PWRFL, sizeof(vector), vector);
+if (trap) {
+    MMR0 = 0;                       /* power-up: memory management off */
+    MMR3 = 0;
+    trap_req |= TRAP_PWRFL;
+    }
+else
+    cpu_set_boot (DMV_PARK);
+#endif
+}
+
+/* Start a boot: the host interface is master-cleared, the CPU taken over;
+   remote load detect asks for the program at once, the others wait for
+   the control station's first poll. */
+static void dmv_boot_begin (CTLR *controller, int how, uint8 address, t_bool trap)
+{
+static const char *hows[] = {"", "power-on boot", "remote load detect", "invoke primary MOP"};
+
+controller->dmv_keep_line = TRUE;           /* the line it boots over stays up */
+dmc_process_master_clear (controller);
+controller->dmv_keep_line = FALSE;
+dmc_set_modem_dtr (controller);             /* DTR on (power-on boot: not yet) */
+memset (&controller->dmv_boot, 0, sizeof(controller->dmv_boot));
+controller->dmv_boot.how = how;
+controller->dmv_boot.address = address;
+controller->dmv_boot.multipoint = (dmv_switch_mode(controller) & 4) != 0;
+controller->dmv_held_valid = FALSE;
+sim_debug(DBG_INF, controller->device, "%s%d: Boot: %s, DDCMP address %d\n",
+          controller->device->name, controller->index, hows[how], address);
+dmv_park_cpu (controller, trap);
+if (how == DMVB_HOW_REMOTE)
+    dmv_boot_request_program (controller);
+else
+    controller->dmv_boot.state = DMVB_POLLWAIT;
+}
+
+/* BOOT DMVn: the power-on boot (E101 SW4) */
+t_stat dmv_boot (int32 unitno, DEVICE *dptr)
+{
+CTLR *controller;
+const char *why;
+uint8 address = 1;                          /* point-to-point */
+
+if ((unitno < 0) || (unitno >= (int32)dptr->numunits - 2) || (unitno >= DMP_NUMDEVICE))
+    return SCPE_ARG;
+controller = (CTLR *)dptr->units[unitno].ctlr;
+if (!(dmv_e101[unitno] & DMV_E101_POWERON))
+    return sim_messagef (SCPE_ARG, "The power-on boot switch (E101 SW4) is off: SET %s%d POWERONBOOT\n", dptr->name, unitno);
+if ((why = dmv_boot_refused (controller)))
+    return sim_messagef (SCPE_ARG, "%s\n", why);
+if (!(dptr->units[unitno].flags & UNIT_ATT))
+    return sim_messagef (SCPE_UNATT, "%s%d is not attached to its line\n", dptr->name, unitno);
+if (dmv_switch_mode(controller) & 4) {      /* multipoint tributary */
+    address = dmv_e113[unitno];
+    if (address == 0)
+        return sim_messagef (SCPE_ARG, "A tributary boots with its address in the tributary switches: SET %s%d TRIBUTARY=n\n", dptr->name, unitno);
+    }
+dmv_boot_begin (controller, DMVB_HOW_POWERON, address, FALSE);
+return SCPE_OK;
+}
+
+/* Invoke primary MOP (from the master clear): as the power-on boot.  A
+   multipoint tributary without a switch address uses the first tributary
+   the program established, not with the power-on boot switch (4.7.4.2).
+   TRUE if the boot started. */
+t_bool dmv_boot_invoke (CTLR *controller, uint8 soft_address)
+{
+const char *why = dmv_boot_refused (controller);
+uint8 address = 1;
+
+if (!why && (dmv_switch_mode(controller) & 4)) {
+    address = dmv_switch_address(controller);
+    if (address == 0) {
+        if (dmv_e101[dmv_line(controller)] & DMV_E101_POWERON)
+            why = "software-assigned tributary address with the power-on boot switch on";
+        else if ((address = soft_address) == 0)
+            why = "no tributary address (switches 0, none established)";
+        }
+    }
+if (why) {
+    sim_debug(DBG_WRN, controller->device, "%s%d: Invoke primary MOP ignored: %s\n",
+              controller->device->name, controller->index, why);
+    return FALSE;
+    }
+dmv_boot_begin (controller, DMVB_HOW_INVOKE, address, TRUE);
+return TRUE;
+}
+
+/* Remote load detect is armed */
+t_bool dmv_remote_load_watch (CTLR *controller)
+{
+return DMV_BOOT_SUPPORTED && dmv_is_dmv(controller) &&
+       (dmv_e101[dmv_line(controller)] & DMV_E101_REMOTELOAD) &&
+       !dmv_boot_active(controller) && (dmv_boot_refused(controller) == NULL) &&
+       dmc_is_attached(controller->unit);
+}
+
+/* A packet from a line: one read ahead for remote load detect first */
+void dmv_get_packet (CTLR *controller, TMLN *lp, const uint8 **pkt, uint16 *size)
+{
+if (controller->dmv_held_valid && (lp == controller->line)) {
+    controller->dmv_held_valid = FALSE;
+    *pkt = controller->dmv_held;
+    *size = controller->dmv_held_size;
+    return;
+    }
+ddcmp_tmxr_get_packet_ln (lp, pkt, size, *controller->corruption_factor);
+}
+
+/* An Enter MOP Mode (Boot) message for this station with the right
+   password: start the remote load detect boot. */
+static t_bool dmv_enter_mop (CTLR *controller, const uint8 *pkt, uint16 size)
+{
+uint8 address = 1;
+const uint8 *mop = pkt + DDCMP_HEADER_SIZE;
+size_t len, vlen, i;
+t_bool match;
+
+if (pkt[0] != DDCMP_DLE)
+    return FALSE;
+if ((size < DDCMP_HEADER_SIZE + 1 + DDCMP_CRC_SIZE) ||
+    ddcmp_crc16 (0, pkt, DDCMP_HEADER_SIZE) || ddcmp_crc16 (0, mop, size - DDCMP_HEADER_SIZE)) {
+    sim_debug(DBG_INF, controller->device, "%s%d: Remote load detect: damaged maintenance message (%d bytes) ignored\n",
+              controller->device->name, controller->index, size);
+    return FALSE;
+    }
+len = size - (DDCMP_HEADER_SIZE + DDCMP_CRC_SIZE);
+sim_debug(DBG_INF, controller->device, "%s%d: Remote load detect: MOP message %d, %d bytes, address %d, data %02X %02X %02X %02X %02X\n",
+          controller->device->name, controller->index, mop[0], (int)len, pkt[5],
+          (len > 1) ? mop[1] : 0, (len > 2) ? mop[2] : 0, (len > 3) ? mop[3] : 0, (len > 4) ? mop[4] : 0, (len > 5) ? mop[5] : 0);
+if ((mop[0] != DMV_MOP_ENTER) || (len < 5))
+    return FALSE;
+if (dmv_switch_mode(controller) & 4) {      /* tributary: its own address only */
+    address = dmv_switch_address(controller) ? dmv_switch_address(controller) : dmv_first_tributary(controller);
+    if (pkt[5] != address) {
+        sim_debug(DBG_INF, controller->device, "%s%d: Enter MOP Mode for address %d ignored\n",
+                  controller->device->name, controller->index, pkt[5]);
+        return FALSE;
+        }
+    }
+/* The verification (4 bytes, MOP 2.1, or 8, MOP 3) must equal the
+   tributary address/password switches. */
+vlen = (len >= 9) ? 8 : 4;
+match = (mop[1] == dmv_switch_address(controller));
+for (i = 2; i <= vlen; i++)
+    if (mop[i] != 0)
+        match = FALSE;
+if (!match) {
+    sim_debug(DBG_INF, controller->device, "%s%d: Enter MOP Mode with a wrong password ignored\n",
+              controller->device->name, controller->index);
+    return FALSE;
+    }
+dmv_boot_begin (controller, DMVB_HOW_REMOTE, address, TRUE);
+return TRUE;
+}
+
+/* Remote load detect: read one packet ahead while the host takes none.
+   An Enter MOP Mode for this station starts the boot; any other packet is
+   held for the host, and dropped if it is still not taken at the next
+   poll (the other station sends it again). */
+t_bool dmv_peek (CTLR *controller)
+{
+const uint8 *pkt = NULL;
+uint16 size = 0;
+
+if (!controller->line || !controller->line->conn)
+    return FALSE;
+if (controller->dmv_held_valid) {
+    controller->dmv_held_valid = FALSE;
+    sim_debug(DBG_INF, controller->device, "%s%d: Message dropped: no receive buffer\n",
+              controller->device->name, controller->index);
+    }
+ddcmp_tmxr_get_packet_ln (controller->line, &pkt, &size, *controller->corruption_factor);
+if (!pkt)
+    return FALSE;
+if (dmv_enter_mop (controller, pkt, size))
+    return TRUE;
+controller->dmv_held = (uint8 *)realloc (controller->dmv_held, size);
+if (controller->dmv_held == NULL)
+    return FALSE;
+memcpy (controller->dmv_held, pkt, size);
+controller->dmv_held_size = size;
+controller->dmv_held_valid = TRUE;
+return TRUE;
+}
+
+static uint32 dmv_le32 (const uint8 *p)
+{
+return (uint32)p[0] | ((uint32)p[1] << 8) | ((uint32)p[2] << 16) | ((uint32)p[3] << 24);
+}
+
+/* Start the loaded program through vector 24 (see above) */
+static void dmv_boot_start (CTLR *controller, uint32 xfer)
+{
+#if DMV_BOOT_SUPPORTED
+uint16 vector[2];
+
+Map_ReadW (VEC_PWRFL, 4, &controller->dmv_boot.saved[0]);   /* the program's words */
+Map_ReadW (DMV_PUSH, 4, &controller->dmv_boot.saved[2]);
+if (xfer > 0177777)
+    sim_debug(DBG_WRN, controller->device, "%s%d: Boot: transfer address %o above 64 KB, started at %o\n",
+              controller->device->name, controller->index, xfer, xfer & 0177777);
+vector[0] = (uint16)(xfer & 0177777);
+vector[1] = 0000340;
+Map_WriteW (VEC_PWRFL, sizeof(vector), vector);
+MMR0 = 0;
+MMR3 = 0;
+trap_req |= TRAP_PWRFL;
+controller->dmv_boot.xfer = xfer;
+controller->dmv_boot.state = DMVB_START;
+sim_activate_abs (controller->unit, 1);     /* dmv_boot_finish() */
+#endif
+}
+
+/* After the start trap: the program's own words at 24-26 and 774-776 */
+void dmv_boot_finish (CTLR *controller)
+{
+#if DMV_BOOT_SUPPORTED
+if (trap_req & TRAP_PWRFL) {                /* not taken yet */
+    sim_activate_abs (controller->unit, 1);
+    return;
+    }
+Map_WriteW (VEC_PWRFL, 4, &controller->dmv_boot.saved[0]);
+Map_WriteW (DMV_PUSH, 4, &controller->dmv_boot.saved[2]);
+sim_debug(DBG_INF, controller->device, "%s%d: Boot: program started at %o\n",
+          controller->device->name, controller->index, controller->dmv_boot.xfer);
+#endif
+controller->dmv_boot.state = DMVB_IDLE;
+}
+
+/* A MOP message during the boot */
+static void dmv_boot_mop (CTLR *controller, const uint8 *mop, size_t len)
+{
+uint8 loadnum;
+uint32 addr = 0, xfer = 0;
+const uint8 *data = NULL;
+size_t n = 0, i;
+t_bool transfer = FALSE;
+
+if (len < 1)
+    return;
+if (sim_deb && (controller->device->dctrl & DBG_INF)) {
+    char hex[3 * 16 + 8] = "";
+    size_t k, o = 0;
+
+    for (k = 0; (k < len) && (k < 12); k++)        /* the first 12 bytes */
+        o += sprintf (hex + o, " %02X", mop[k]);
+    if (len > 12) {                                /* ... and the last 4 */
+        o += sprintf (hex + o, " ..");
+        for (k = (len > 16) ? len - 4 : 12; k < len; k++)
+            o += sprintf (hex + o, " %02X", mop[k]);
+        }
+    sim_debug(DBG_INF, controller->device, "%s%d: Boot: MOP message received, %d bytes:%s\n",
+              controller->device->name, controller->index, (int)len, hex);
+    }
+switch (mop[0]) {
+    case DMV_MOP_LOAD:                      /* code, load number, address, data */
+        if (len < 6)
+            return;
+        loadnum = mop[1];
+        addr = dmv_le32 (mop + 2);
+        data = mop + 6;
+        n = len - 6;
+        break;
+    case DMV_MOP_LOAD_XFER:                 /* code, load number, [address, [data]], transfer */
+        if (len < 6)
+            return;
+        loadnum = mop[1];
+        transfer = TRUE;
+        if (len == 6)
+            xfer = dmv_le32 (mop + 2);
+        else if (len >= 10) {
+            addr = dmv_le32 (mop + 2);
+            data = mop + 6;
+            n = len - 10;
+            xfer = dmv_le32 (mop + len - 4);
+            }
+        else
+            return;
+        break;
+    case DMV_MOP_PARAM_XFER:                /* code, load number, parameters, 0, transfer */
+        if (len < 7)
+            return;
+        loadnum = mop[1];
+        for (i = 2; (i < len) && (mop[i] != 0); i += 2 + mop[i + 1])
+            if (i + 1 >= len)
+                return;
+        if (i + 1 + 4 > len)
+            return;
+        xfer = dmv_le32 (mop + i + 1);      /* the parameters are not used */
+        transfer = TRUE;
+        break;
+    case DMV_MOP_ENTER:                     /* again: the request is on its way */
+        return;
+    default:
+        sim_debug(DBG_INF, controller->device, "%s%d: Boot: MOP message %d ignored\n",
+                  controller->device->name, controller->index, mop[0]);
+        return;
+    }
+/* Load number 0 is always valid and restarts the sequence; the previous
+   one again means the request was lost: it is repeated. */
+if ((loadnum != controller->dmv_boot.loadnum) && (loadnum != 0)) {
+    if ((loadnum == (uint8)(controller->dmv_boot.loadnum - 1)) && controller->dmv_boot.last_len)
+        dmv_boot_send (controller, controller->dmv_boot.last, controller->dmv_boot.last_len);
+    else
+        sim_debug(DBG_INF, controller->device, "%s%d: Boot: load %d out of sequence (expected %d)\n",
+                  controller->device->name, controller->index, loadnum, controller->dmv_boot.loadnum);
+    return;
+    }
+sim_debug(DBG_INF, controller->device, "%s%d: Boot: load %d, %d bytes at %o%s\n", controller->device->name,
+          controller->index, loadnum, (int)n, addr, transfer ? ", transfer" : "");
+if (n && (Map_WriteB (addr, (int32)n, data) != 0)) {
+    controller->dmv_boot.loadnum = loadnum;
+    dmv_boot_request_load (controller, loadnum, 1);     /* memory could not take it */
+    return;
+    }
+if (transfer) {
+    dmv_boot_start (controller, xfer);
+    return;
+    }
+controller->dmv_boot.loadnum = (uint8)(loadnum + 1);
+dmv_boot_request_load (controller, controller->dmv_boot.loadnum, 0);
+}
+
+/* Receive while booting: MOP messages for this station; the first other
+   message (a poll) is answered with Request Program.  Unanswered requests
+   are sent again. */
+t_bool dmv_boot_receive (CTLR *controller)
+{
+const uint8 *pkt = NULL;
+uint16 size = 0;
+t_bool ans = FALSE;
+
+if (controller->dmv_boot.state == DMVB_START)
+    return FALSE;
+while (controller->line && controller->line->conn) {
+    dmv_get_packet (controller, controller->line, &pkt, &size);
+    if (!pkt)
+        break;
+    ans = TRUE;
+    if ((size < DDCMP_HEADER_SIZE) || ddcmp_crc16 (0, pkt, DDCMP_HEADER_SIZE))
+        continue;                           /* damaged header */
+    if (controller->dmv_boot.multipoint && (pkt[5] != controller->dmv_boot.address))
+        continue;                           /* for another tributary */
+    if (pkt[0] == DDCMP_DLE) {
+        if ((size < DDCMP_HEADER_SIZE + DDCMP_CRC_SIZE) || ddcmp_crc16 (0, pkt + DDCMP_HEADER_SIZE, size - DDCMP_HEADER_SIZE))
+            continue;                       /* damaged data */
+        dmv_boot_mop (controller, pkt + DDCMP_HEADER_SIZE, size - (DDCMP_HEADER_SIZE + DDCMP_CRC_SIZE));
+        if (controller->dmv_boot.state == DMVB_START)
+            break;
+        }
+    else if (controller->dmv_boot.state == DMVB_POLLWAIT) {
+        sim_debug(DBG_INF, controller->device, "%s%d: Boot: first poll received\n",
+                  controller->device->name, controller->index);
+        dmv_boot_request_program (controller);
+        }
+    }
+if (((controller->dmv_boot.state == DMVB_REQUEST) || (controller->dmv_boot.state == DMVB_LOADING)) &&
+    controller->dmv_boot.last_len &&
+    (controller->dmv_boot.last_unsent || ((sim_os_msec() - controller->dmv_boot.last_time) >= DMV_BOOT_RETRY)))
+    dmv_boot_send (controller, controller->dmv_boot.last, controller->dmv_boot.last_len);
+return ans;
+}
