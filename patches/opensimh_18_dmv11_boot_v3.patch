+#define DMV_E101_UNIT1       0x002  /* SW2 OFF: unit number for booting 1 (ON: 0) */
+#define DMV_E101_AUTOANSWER  0x004  /* SW3: auto answer (no effect here) */
+#define DMV_E101_POWERON     0x008  /* SW4 OFF: power-on boot enabled */
+#define DMV_E101_REMOTELOAD  0x010  /* SW5 OFF: remote load detect enabled */
+#define DMV_E101_V_MODE      5      /* SW6-8: mode (Table 4-5) - SW6 OFF full
+                                       duplex, SW7 OFF not DMC compatible or
+                                       tributary, SW8 OFF multipoint; this is
+                                       the mode code of Table 3-4 */
+#define DMV_E101_M_MODE      (7 << DMV_E101_V_MODE)
+#define DMV_E101_HIGHSPEED   0x100  /* SW9 OFF: 19.2 kb/s or more (no effect here) */
+#define DMV_E101_V35         0x200  /* SW10 OFF: RS-232-C/RS-423-A, ON: V.35 (no effect here) */
+
+/* DMV11 boot states (CTLR dmv_boot.state) and how a boot was started */
+#define DMVB_IDLE           0       /* no boot */
+#define DMVB_POLLWAIT       1       /* waiting for the control station's first poll */
