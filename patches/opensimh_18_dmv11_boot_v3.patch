+/* ---------------------------------------------------------------------------
+   DMV11 switch packs and primary MOP boot (EK-DMVQM-UG-003)
+
+   Switch packs (Figure 2-6, Table 2-6, Table 4-5): E101 (E107 on the M8064)
+   holds the switch selectable features, E113 (E119) the 8-bit tributary
+   address/password ("DDCMP address register", SW1 = bit 0, OFF = 1).  The
+   mode switches set the station type at every master clear; a switch
+   address makes a multipoint tributary answer only to that address.
+
+   Primary MOP boot (section 4.7, PDP-11 only).  The DMV11 at a remote
+   station (point-to-point, or multipoint tributary) boots its host CPU:
+
+   - remote load detect (E101 SW5): an Enter MOP Mode message for its
+     address with the switch value as password,
+   - power-on boot (E101 SW4): BOOT DMVn; the first poll from the control
+     station is answered with Request Program,
+   - invoke primary MOP: the program sets BSEL1 bits 5 and 6; then as with
+     power-on boot.
+
+   The manual describes the takeover only in outline: the DMV11 "NPRs a
+   tight-loop routine into main memory", "transfers control to the routine
+   through the powerfail/restart vector", sends Request Program, loads the
+   program it gets and starts it.  Here the routine is MOV #1000,SP / WAIT /
+   BR .-2 at 40 (reserved vector locations), entered through vector 24 at
+   priority 7 with memory management off, as after a power-up.  In the
+   WAIT the CPU fetches nothing, so the program may be loaded over the
+   routine.  The start goes through vector 24 again; the trap pushes two
+   words at 774-776 (below SP = 1000), and the program's own words at 24-26
+   and 774-776 are put back right after the trap.  The program starts with
+   SP 774, so it has the usual stack below 1000 (SP 404 at first left a
+   program that sets up no stack of its own, such as remwrt, without one).  The DMV11 keeps its host
+   interface master-cleared during the boot and afterwards.
+
+   MOP messages (MOP V3 AA-X436A-TK; DMV11 device type 34 from the MOP
+   registry): Request Program asks for a secondary loader (primary mode);
+   Memory Load segments are acknowledged with Request Memory Load (next
+   load number, error 1 if the memory could not take it); Memory Load with
+   Transfer Address or Parameter Load with Transfer Address starts the
+   program.  A request without an answer is sent again every 5 seconds.
+   --------------------------------------------------------------------------- */
+
+#define DMV_MOP_LOAD_XFER   0       /* Memory Load with Transfer Address */
+#define DMV_MOP_LOAD        2       /* Memory Load */
+#define DMV_MOP_ENTER       6       /* Enter MOP Mode (MOP 2.1) / Boot (MOP 3) */
+#define DMV_MOP_REQ_PROGRAM 8       /* Request Program */
+#define DMV_MOP_REQ_LOAD    10      /* Request Memory Load */
+#define DMV_MOP_PARAM_XFER  20      /* Parameter Load with Transfer Address */
+#define DMV_MOP_DEVTYPE     34      /* MOP device type of the DMV11 */
+#define DMV_BOOT_RETRY      5000    /* msec without an answer before a request is repeated */
+#define DMV_PARK            0000040 /* the CPU's waiting routine */
+#define DMV_PARK_SP         0001000 /* its SP, also the started program's stack
+                                       (below 1000, as usual for standalone
+                                       programs; 404 left remwrt no stack) */
+#define DMV_PUSH            0000774 /* the start trap pushes PC, PSW at 774, 776 */
+
+static const char *dmv_mode_names[8] = {
+    "HDXDMC", "FDXDMC", "HDXPOINT", "FDXPOINT",
+    "HDXCONTROL", "FDXCONTROL", "HDXTRIBUTARY", "FDXTRIBUTARY" };
+
+/* A DMV11 line (not a DMC, DMR or DMP) */
+t_bool dmv_is_dmv (CTLR *controller)
+{
+return (!dmc_is_dmc(controller) && (controller->device == &dmv_dev));
+}
+
+/* DMV line number of a DMV controller (index into dmv_e101/dmv_e113) */
+static int dmv_line (CTLR *controller)
+{
+return controller->index - DMC_NUMDEVICE;
+}
+
+/* E101 SW1 OFF: the mode comes from SW6-8 */
+t_bool dmv_mode_from_switches (CTLR *controller)
+{
+return dmv_is_dmv(controller) && (dmv_e101[dmv_line(controller)] & DMV_E101_MODE_ENABLE);
+}
+
+/* The mode code (Table 3-4) of switches SW6-8 */
+uint16 dmv_switch_mode (CTLR *controller)
+{
+return (dmv_e101[dmv_line(controller)] & DMV_E101_M_MODE) >> DMV_E101_V_MODE;
+}
+
+/* The tributary address/password switches (E113), 0 for other devices */
+uint8 dmv_switch_address (CTLR *controller)
+{
+return dmv_is_dmv(controller) ? dmv_e113[dmv_line(controller)] : 0;
+}
+
+/* The first established tributary (lowest status slot), 0 if none */
+uint8 dmv_first_tributary (CTLR *controller)
+{
+int i;
+
+for (i = 0; i < DMP_MAX_TRIBS; i++)
+    if (controller->dmp_trib[i].in_use)
+        return controller->dmp_trib[i].address;
+return 0;
+}
+
+/* DMV line of a unit given to a SET or SHOW command, -1 if none */
+static int dmv_unit_line (UNIT *uptr)
+{
+int ln = (int)(uptr - dmv_dev.units);
+
+return ((ln >= 0) && (ln < DMP_NUMDEVICE) && (ln < (int)dmv_dev.numunits - 2)) ? ln : -1;
+}
+
+t_stat dmv_set_mode (UNIT *uptr, int32 val, CONST char *cptr, void *desc)
+{
+int ln = dmv_unit_line(uptr);
+char gbuf[CBUFSIZE];
+int i;
+
+if (ln < 0)
+    return SCPE_IERR;
+if ((cptr == NULL) || (*cptr == '\0'))
+    return SCPE_MISVAL;
+get_glyph (cptr, gbuf, 0);
+if (strcmp (gbuf, "SOFTWARE") == 0) {               /* SW1 ON */
+    dmv_e101[ln] &= ~DMV_E101_MODE_ENABLE;
+    return SCPE_OK;
+    }
+for (i = 0; i < 8; i++)
+    if (strcmp (gbuf, dmv_mode_names[i]) == 0) {    /* SW1 OFF, SW6-8 */
+        dmv_e101[ln] = (dmv_e101[ln] & ~DMV_E101_M_MODE) | (uint16)(i << DMV_E101_V_MODE) | DMV_E101_MODE_ENABLE;
+        return SCPE_OK;
+        }
+return sim_messagef (SCPE_ARG, "Unknown mode: %s (SOFTWARE, HDXDMC, FDXDMC, HDXPOINT, FDXPOINT,\n"
+                               "HDXCONTROL, FDXCONTROL, HDXTRIBUTARY or FDXTRIBUTARY)\n", gbuf);
+}
+
+t_stat dmv_show_mode (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
+{
+int ln = dmv_unit_line(uptr);
+
+if (ln < 0)
+    return SCPE_IERR;
+if (dmv_e101[ln] & DMV_E101_MODE_ENABLE)
+    fprintf (st, "MODE=%s\n", dmv_mode_names[(dmv_e101[ln] & DMV_E101_M_MODE) >> DMV_E101_V_MODE]);
+else
+    fprintf (st, "MODE=SOFTWARE\n");
+return SCPE_OK;
+}
+
+t_stat dmv_set_tributary (UNIT *uptr, int32 val, CONST char *cptr, void *desc)
+{
+int ln = dmv_unit_line(uptr);
+t_stat r;
+uint32 address;
+
+if (ln < 0)
+    return SCPE_IERR;
+if ((cptr == NULL) || (*cptr == '\0'))
+    return SCPE_MISVAL;
+address = (uint32)get_uint (cptr, 10, 255, &r);
+if (r != SCPE_OK)
+    return sim_messagef (SCPE_ARG, "Tributary address must be 0-255\n");
+dmv_e113[ln] = (uint8)address;
+return SCPE_OK;
+}
+
+t_stat dmv_show_tributary (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
+{
+int ln = dmv_unit_line(uptr);
+
+if (ln < 0)
+    return SCPE_IERR;
+fprintf (st, "TRIBUTARY=%d\n", dmv_e113[ln]);
+return SCPE_OK;
+}
+
+/* The boot switches exist on every DMV11, but only a PDP-11 can be booted */
+static t_stat dmv_boot_switch_refused (void)
