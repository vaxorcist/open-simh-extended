From 318276b36264102cfdbd28d3602062a87e75a801 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 12:47:07 +0100
Subject: [PATCH] TS realism mode: show the ON-LINE switch; SET TS LOAD says
 off-line

In the realism mode SET TS LOAD threads the tape to BOT and the transport
stays off-line until SET TS ONLINE, as on a real TS04/TS05.  Nothing showed
that: after ATTACH and SET TS LOAD, VMS MOUNT MSA0: just asked the operator
to mount the device (Ulli).  Now SHOW TS ends the reel line with ", on-line"
or ", off-line", and SET TS LOAD reports "tape loaded, the transport is
off-line (SET TS ONLINE)".  The normal mode is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SuavtftJEqWTX7fajw6zWU
---
 PDP11/pdp11_ts.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/PDP11/pdp11_ts.c b/PDP11/pdp11_ts.c
index f1a0e326..548b3473 100644
--- a/PDP11/pdp11_ts.c
+++ b/PDP11/pdp11_ts.c
@@ -1568,6 +1568,9 @@ ts_check_online ();
 if (!(sim_switches & SWMASK ('N')))                     /* at the prompt: wait */
     sim_reel_wait (&ts_reel);
 ts_check_online ();
+if ((val == TS_PNL_LOAD) && !ts_is_online ())           /* LOAD does not put it on-line */
+    return sim_messagef (SCPE_OK, "%s: tape loaded, the transport is off-line (SET %s ONLINE)\n",
+                         sim_uname (uptr), sim_uname (uptr));
 return SCPE_OK;
 }
 
@@ -1617,8 +1620,11 @@ return sim_tape_set_capac (uptr, val, cptr, desc);
 
 static t_stat ts_show_capac (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
 {
-if (TS_REAL)
-    return ts_show_reel (st, uptr, val, desc);
+if (TS_REAL) {                                          /* reel and ON-LINE switch */
+    ts_show_reel (st, uptr, val, desc);
+    fprintf (st, ", %s", ts_is_online () ? "on-line" : "off-line");
+    return SCPE_OK;
+    }
 return sim_tape_show_capac (st, uptr, val, desc);
 }
 
