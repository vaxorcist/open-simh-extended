+memcpy (c->R, R, sizeof (c->R));
+memcpy (c->STK, STK, sizeof (c->STK));
+c->PSL = PSL;
+c->SCBB = SCBB; c->PCBB = PCBB;
+c->P0BR = P0BR; c->P0LR = P0LR; c->P1BR = P1BR; c->P1LR = P1LR;
+c->SBR = SBR; c->SLR = SLR;
