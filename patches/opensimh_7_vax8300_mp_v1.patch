 struct reglink regtable[] = {
     { WATCHBASE, WATCHBASE+WATCHSIZE, &wtc_rd_pa, &wtc_wr_pa },
+    { 0x20080000, 0x20080100, &ka_priv_rd, &ka_priv_wr },  /* local BIIC */
     { 0x20088000, 0x20088004, &pcsr_rd, &pcsr_wr },
     { 0x200B0000, 0x200B0020, &fl_rd, &fl_wr },
     { 0, 0, NULL, NULL }
