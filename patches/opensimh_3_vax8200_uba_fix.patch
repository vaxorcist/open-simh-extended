From a009d86c2873fdc14207634dc6b5bf1c95a9fbaa Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 20:45:01 +0100
Subject: [PATCH 2/3] VAX8200: BICSR Start Self-Test also initializes the
 UNIBUS

BICSR bit 10 (BICSR_RST) is the BIIC's Start Self-Test bit.  On the DWBUA
it runs the self-test, which re-initializes the adapter, and the DWBUA
asserts UNIBUS AC LO, which initializes the UNIBUS as well
(EK-DWBUA-TM-001, sections 2.3.1 and 3.3.2 item 4).  The simulator only
reset the adapter, so Unibus devices kept their state: under VMS V4.7 the
UDA50 kept polling the rings set up by VMB, hit an invalid map register
after VMS had reloaded the map, and raised the DWBUA error interrupt that
exposed the interrupt level bug fixed in the previous commit.

Now the Unibus devices are reset too (uba_ubpdn), with UBPUP cleared
for the Unibus initialization time.  VMS V4.7 boots without the map
error.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 VAX/vax820_uba.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/VAX/vax820_uba.c b/VAX/vax820_uba.c
index fe67859e..762c2b67 100644
--- a/VAX/vax820_uba.c
+++ b/VAX/vax820_uba.c
@@ -387,8 +387,17 @@ if (ofs >= UBAMAP_OF) {                                 /* map? */
 switch (ofs) {                                          /* case on offset */
 
     case BI_CSR:
-        if (val & BICSR_RST)                            /* unibus power init */
+        /* BICSR bit 10 (BICSR_RST here) is the BIIC's Start Self-Test
+           bit.  On the DWBUA it runs the self-test, which re-initializes
+           the adapter, and the DWBUA asserts UNIBUS AC LO, which also
+           initializes the UNIBUS (EK-DWBUA-TM-001, 2.3.1 and 3.3.2 item 4).
+           Earlier versions reset only the adapter, so Unibus devices
+           kept running with stale state (a UDA50 still polling the rings
+           set up by VMB hit an invalid map register under VMS). */
+        if (val & BICSR_RST) {                          /* start self-test */
             uba_reset (&uba_dev);                       /* reset adapter */
+            uba_ubpdn (uba_uitime);                     /* and init the UNIBUS */
+            }
         uba_biic.csr = (uba_biic.csr & ~BICSR_RW) | (val & BICSR_RW);
         break;
 
-- 
2.43.0


From ade0cba3593edf8d68eaaa8b26134e0dbe2d89c0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 21:56:18 +0100
Subject: [PATCH 3/3] VAX8200: BOOT CS (console RX50) no longer fails with
 "Invalid argument"

The 8200 boot parser rejected every device without a DIB, so the
console floppy CS, which is in the boot table (BOOT_CS), could never be
booted: BOOT CS0 gave "Invalid argument". The VAX-11/780 and 8600
parsers use base address 0 for such a device; the 8200 now does the
same. VMB then loads from the console RX50 (e.g. standalone BACKUP made
by @SYS$UPDATE:STABACKIT CSA1:).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Suavtcc46vFhoyQ1F6AQu4
---
 VAX/vax820_bi.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/VAX/vax820_bi.c b/VAX/vax820_bi.c
index 24c78872..da84a760 100644
--- a/VAX/vax820_bi.c
+++ b/VAX/vax820_bi.c
@@ -638,6 +638,7 @@ char gbuf[CBUFSIZE];
 char *slptr;
 const char *regptr;
 int32 i, r5v, unitno;
+uint32 ba;
 DEVICE *dptr;
 UNIT *uptr;
 DIB *dibp;
@@ -656,8 +657,10 @@ dptr = find_unit (gbuf, &uptr);                         /* find device */
 if ((dptr == NULL) || (uptr == NULL))
     return SCPE_ARG;
 dibp = (DIB *) dptr->ctxt;                              /* get DIB */
-if (dibp == NULL)
-    return SCPE_ARG;
+if (dibp == NULL)                                       /* none (console */
+    ba = 0;                                             /* floppy CS): as on */
+else                                                    /* the 780 and 8600 */
+    ba = dibp->ba;
 unitno = (int32) (uptr - dptr->units);
 r5v = 0;
 /* coverity[NULL_RETURNS] */
@@ -675,7 +678,7 @@ for (i = 0; boot_tab[i].name != NULL; i++) {
     if (strcmp (dptr->name, boot_tab[i].name) == 0) {
         R[0] = boot_tab[i].code;
         R[1] = TR_UBA;
-        R[2] = boot_tab[i].let | (dibp->ba & UBADDRMASK);
+        R[2] = boot_tab[i].let | (ba & UBADDRMASK);
         R[3] = unitno;
         R[4] = 0;
         R[5] = r5v;
-- 
