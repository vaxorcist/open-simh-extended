+/* Connection summary of an attached unit: the asynchronous multiplexer
+   (DMF-ASYNC) has eight lines ("n current connections"), the synchronous
+   line (DMF-SYNC) and the parallel interface (DMF-PAR) one each
+   ("connected" or "disconnected"). */
+static t_stat dmf_show_summ (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
+{
+TMXR *mp = &dmf_desc;
+
+if (uptr == &dmf_unit[3])                       /* DMF-SYNC */
+    mp = &dmf_sdesc;
+else if (uptr == &dmf_unit[4])                  /* DMF-PAR */
+    mp = &dmf_ddesc;
+return tmxr_show_summ (st, uptr, val, (void *) mp);
+}
