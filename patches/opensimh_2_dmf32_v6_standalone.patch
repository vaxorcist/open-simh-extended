+/* ---------------------------------------------------------------------------
+   Register layout
+   --------------------------------------------------------------------------- */
+
+#define IOLN_DMF        040                     /* 16 words */
+#define DMF_LINES       8                       /* asynchronous lines */
+#define DMF_MDM_LINES   2                       /* lines with modem control */
+#define DMF_TXSILO      32                      /* transmit silo per line */
+#define DMF_RXSILO      48                      /* shared receive silo */
+#define DMF_RXALARM     16                      /* interrupt above this many */
+
+/* register numbers (word offset from base) */
+#define REG_CSR0        0
+#define REG_CSR1        1
+#define REG_ACSR        6
+#define REG_ALPR        7
+#define REG_ARBUF       8                       /* read RBUF, write RSP */
+#define REG_AIND        9
+#define REG_LCSR        10
+#define REG_LIND        11
+
+/* CSR0 */
+#define C0_ASYNC        0100000                 /* device codes (Table 4-1) */
+#define C0_SYNC         0040000
+#define C0_LP           0020000
+#define C0_DR           0010000
+#define C0_CODE         0170000
+#define C0_VEC          0000377                 /* first vector / 4 */
+#define C0_VALID_CODES  { 0100000, 0120000, 0150000, 0160000 }
+#define C0_EMULATED     (C0_ASYNC|C0_SYNC|C0_LP|C0_DR)  /* parts this emulation has */
+
+/* CSR1 high byte commands and results (Table 4-4) */
+#define C1_PARITY       0x55                    /* force parity error */
+#define C1_SELFTEST     0xAA                    /* restart / self test passed */
+#define C1_REVLEVEL     0x2A                    /* request microcode revision */
+#define DMF_UCODE_REV   0x28                    /* BCD: version 28 (tab, truncation) */
+
+/* asynchronous CSR (Table 4-23) */
+#define AC_IAD          0000037                 /* indirect address */
+#define AC_MR           0000040                 /* master reset */
+#define AC_RIE          0000100                 /* receive interrupt enable */
+#define AC_RDA          0000200                 /* receive data available (ro) */
+#define AC_V_TLINE      8
+#define AC_TLINE        0003400                 /* transmit line number (ro) */
+#define AC_NXM          0010000                 /* transmit DMA error (ro) */
+#define AC_TIE          0040000                 /* transmit interrupt enable */
+#define AC_TRDY         0100000                 /* transmitter ready (ro) */
+#define AC_RW           (AC_IAD|AC_RIE|AC_TIE)
+
+/* line parameter register (Table 4-24) */
+#define LP_LINE         0000007
+#define LP_V_LEN        3                       /* character length - 5 */
+#define LP_PEN          0000040                 /* parity enable */
+#define LP_EVEN         0000100                 /* even parity */
+#define LP_2STOP        0000200                 /* two stop bits */
+#define LP_V_RSPD       8                       /* receive speed (lines 0,1) */
+#define LP_V_TSPD       12                      /* transmit speed */
+
+/* receive buffer (Table 4-26) */
+#define RB_V_LINE       8
+#define RB_DSC          0004000                 /* data set change */
+#define RB_PE           0010000                 /* parity error */
+#define RB_FE           0020000                 /* framing error */
+#define RB_OVR          0040000                 /* overrun */
+#define RB_VALID        0100000                 /* data valid */
+
+/* line control register, indirect 8-15 low byte (Table 4-29) */
+#define LC_TE           0000001                 /* transmit enable */
+#define LC_AUTOX        0000002                 /* auto XON/XOFF */
+#define LC_RE           0000004                 /* receive enable */
+#define LC_BRK          0000010                 /* break */
+#define LC_FLUSH        0000020                 /* flush transmit silo */
+#define LC_DSCE         0000040                 /* data set change enable */
+#define LC_V_MAINT      6
+#define LC_MAINT        0000300
+#define  MAINT_NORMAL    0
+#define  MAINT_ECHO      1                      /* automatic echo */
+#define  MAINT_LOCAL     2                      /* local loopback */
+#define  MAINT_REMOTE    3                      /* remote loopback */
+/* transmit modem register, indirect 8-15 high byte */
+#define TM_USRW         0000400                 /* user transmit (pin 18) */
+#define TM_DTR          0001000                 /* data terminal ready */
+#define TM_RATE         0002000                 /* data signal rate select */
+#define TM_SRTS         0004000                 /* secondary request to send */
+#define TM_RTS          0010000                 /* request to send */
+#define TM_PREEMPT      0100000                 /* preempt output */
+#define TM_RW           (TM_USRW|TM_DTR|TM_RATE|TM_SRTS|TM_RTS|TM_PREEMPT)
+
+/* receive modem register, indirect 0-7 high byte (Figure 4-22) */
+#define RM_USRR         0002000                 /* user receive (pin 25) */
+#define RM_SCD          0004000                 /* secondary carrier detect */
+#define RM_CTS          0010000                 /* clear to send */
+#define RM_CD           0020000                 /* carrier detect */
+#define RM_RI           0040000                 /* ring indicator */
+#define RM_DSR          0100000                 /* data set ready */
+
+/* DMA character count register, indirect 24-31 */
+#define TC_COUNT        0037777
+#define TC_V_XADDR      14                      /* buffer address bits 17:16 */
+
+/* line printer CSR (Table 4-33) */
+#define LC_PEN          0000001                 /* print enable */
+#define LC_MR           0000002                 /* master reset */
+#define LC_FMT          0000004                 /* format control */
+#define LC_MAINTM       0000040                 /* maintenance mode */
+#define LC_IE           0000100                 /* interrupt enable */
+#define LC_DONE         0000200                 /* print done (ro) */
+#define LC_V_IAD        8
+#define LC_IAD          0003400                 /* indirect address */
+#define LC_CONV         0010000                 /* connect verify: 1 = not connected */
+#define LC_DAVRDY       0020000                 /* DAVFU ready */
+#define LC_OFFLINE      0040000                 /* printer offline (error) */
+#define LC_DMAERR       0100000                 /* DMA error (ro) */
+#define LC_RW           (LC_PEN|LC_FMT|LC_MAINTM|LC_IE|LC_IAD)
+
+/* line printer indirect register 6 (Table 4-34) */
+#define LF_XADDR        0000003                 /* buffer address bits 17:16 */
+#define LF_NOAUTOCR     0000400                 /* set: no automatic CR insertion */
+#define LF_NOFFCONV     0001000                 /* set: pass FF, no LF conversion */
+#define LF_NONPRINT     0002000                 /* set: accept non printable */
+#define LF_DAVFU        0004000                 /* DAVFU printer */
+#define LF_WRAP         0010000                 /* line wrap */
+#define LF_NOTRUNC      0020000                 /* inhibit truncation */
+#define LF_NOTAB        0040000                 /* inhibit tab expansion */
+#define LF_NOUPPER      0100000                 /* set: no lower to upper case */
+
+/* interrupt vector numbers (Table 4-2) */
+#define VEC_SRX         0
+#define VEC_STX         1
+#define VEC_DRA         2
+#define VEC_DRB         3
+#define VEC_ARX         4
+#define VEC_ATX         5
+#define VEC_LP          6
+
+/* debug flags */
+#define DBG_REG         0x0001                  /* register accesses */
+#define DBG_INT         0x0002                  /* interrupts */
+#define DBG_DMA         0x0004                  /* DMA transfers */
+#define DBG_LPT         0x0008                  /* line printer cycles */
+#define DBG_SXMT        0x0010                  /* synchronous transmit */
+#define DBG_SRCV        0x0020                  /* synchronous receive */
+#define DBG_DR          0x0040                  /* parallel interface signals */
+#define DBG_XMT         TMXR_DBG_XMT
+#define DBG_RCV         TMXR_DBG_RCV
+#define DBG_MDM         TMXR_DBG_MDM
+#define DBG_CON         TMXR_DBG_CON
+#define DBG_TRC         TMXR_DBG_TRC
