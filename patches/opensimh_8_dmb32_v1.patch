diff --git a/VAX/vax_combo_lib.c b/VAX/vax_combo_lib.c
new file mode 100644
index 00000000..34ca8203
--- /dev/null
+++ b/VAX/vax_combo_lib.c
@@ -0,0 +1,152 @@
+/* vax_combo_lib.c: shared parts of the DMF32 and DMB32 combination boards
+
+   Permission is hereby granted, free of charge, to any person obtaining a
+   copy of this software and associated documentation files (the "Software"),
+   to deal in the Software without restriction, including without limitation
+   the rights to use, copy, modify, merge, publish, distribute, sublicense,
+   and/or sell copies of the Software, and to permit persons to whom the
+   Software is furnished to do so, subject to the following conditions:
+
+   The above copyright notice and this permission notice shall be included in
+   all copies or substantial portions of the Software.
+
+   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+   THE AUTHORS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER
+   IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+   CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+   Shared parts of the DMF32 (vax_dmf.c) and DMB32 (vax_dmb.c); see
+   vax_combo_lib.h.
+
+   References:
+     EK-DMF32-UG-003  DMF32 User's Guide (line printer, Table 4-34)
+     EK-DMB32-UG-001  DMB32 User Guide (printer registers, 3.3.22-3.3.27)
+
+   Modification history:
+
+   15-Nov-26    Ulli/Claude  First version: printer formatter (from vax_dmf.c)
+*/
+
+#include "vax_combo_lib.h"
+
+/* ---------------------------------------------------------------------------
+   Line printer formatter
+   --------------------------------------------------------------------------- */
+
+/* Top of form, column 0 (printer port initialized). */
+void combo_lp_reset (COMBO_LP *lp)
+{
+lp->col = 0;
+lp->row = 0;
+lp->crpend = FALSE;
+}
+
+/* One character to the printer, unformatted: count it and track the
+   carriage (column after CR, line after LF and FF). */
+void combo_lp_out (COMBO_LP *lp, int32 c)
+{
+lp->chars++;
+if (!lp->put (lp, c))                           /* did not reach the paper */
+    return;
+if (c == 012) {                                 /* line feed: paper moves */
+    lp->lines++;
+    lp->row++;
+    }
+else if (c == 014)
+    lp->row = 0;
+if (c == 015)
+    lp->col = 0;
+}
+
+/* "New line" (prefix/suffix character 0, line wrap).  The DMF32 always
+   sends CR LF (CLP_NLCR); on the DMB32 the CR comes only with automatic
+   carriage return insertion (UG 3.3.22). */
+void combo_lp_newline (COMBO_LP *lp)
+{
+lp->crpend = FALSE;
+if ((lp->flags & CLP_NLCR) || (lp->flags & CLP_AUTOCR))
+    combo_lp_out (lp, 015);
+lp->col = 0;
+combo_lp_out (lp, 012);
+}
+
+/* One data character through the formatting functions. */
+void combo_lp_format (COMBO_LP *lp, int32 c)
+{
+if (c & 0200) {                                 /* MSB set: non printable */
+    t_bool vfu_code = (lp->flags & CLP_DAVFU) && (c <= 0237);
+
+    if (!(lp->flags & CLP_NONPRINT) && !vfu_code)
+        return;
+    combo_lp_out (lp, c);
+    return;
+    }
+if ((lp->flags & CLP_UPPER) && (c >= 'a') && (c <= 'z'))
+    c = c - 'a' + 'A';                          /* lower to upper case */
+/* Automatic carriage return insertion: a CR is inserted before every LF
+   and FF, and a CR in the data that precedes an LF or FF is stripped, so
+   the printer sees exactly one.  A data CR is therefore held until the
+   next character shows whether it precedes an LF or FF. */
+if (lp->crpend) {
+    lp->crpend = FALSE;
+    if (((c != 012) && (c != 014)) || !(lp->flags & CLP_AUTOCR))
+        combo_lp_out (lp, 015);
+    }
+switch (c) {
+    case 011:                                   /* tab */
+        if (lp->flags & CLP_TAB) {
+            do
+                combo_lp_format (lp, ' ');
+            while (lp->col & 7);
+            return;
+            }
+        break;
+    case 012:                                   /* line feed */
+        if (lp->flags & CLP_AUTOCR)             /* automatic CR before LF */
+            combo_lp_out (lp, 015);
+        lp->col = 0;
+        combo_lp_out (lp, 012);
+        return;
+    case 014:                                   /* form feed */
+        if (lp->flags & CLP_AUTOCR)             /* automatic CR before FF */
+            combo_lp_out (lp, 015);
+        lp->col = 0;
+        if ((lp->flags & CLP_FFCONV) && lp->lpp && !(lp->flags & CLP_DAVFU)) {
+            do                                  /* line feeds to the next page */
+                combo_lp_out (lp, 012);
+            while (lp->row % lp->lpp);
+            lp->row = 0;
+            }
+        else
+            combo_lp_out (lp, 014);
+        return;
+    case 015:                                   /* carriage return: held until */
+        lp->crpend = TRUE;                      /* the next character shows */
+        lp->col = 0;                            /* whether it precedes LF/FF */
+        return;
+    default:
+        break;
+    }
+if ((c >= 040) && lp->width && (lp->col >= lp->width)) {
+    if (lp->flags & CLP_WRAP)                   /* wrap to the next line */
+        combo_lp_newline (lp);
+    else if (lp->flags & CLP_TRUNC)             /* truncate */
+        return;
+    }
+combo_lp_out (lp, c);
+if (c >= 040)
+    lp->col++;
+}
+
+/* Prefix or suffix characters: a count and a character, 0 = new line. */
+void combo_lp_fix (COMBO_LP *lp, int32 count, int32 c)
+{
+while (count-- > 0) {
+    if (c == 0)
+        combo_lp_newline (lp);
+    else
+        combo_lp_format (lp, c);
+    }
+}
diff --git a/VAX/vax_combo_lib.h b/VAX/vax_combo_lib.h
new file mode 100644
index 00000000..a46a778f
--- /dev/null
+++ b/VAX/vax_combo_lib.h
@@ -0,0 +1,80 @@
+/* vax_combo_lib.h: shared parts of the DMF32 and DMB32 combination boards
+
+   Permission is hereby granted, free of charge, to any person obtaining a
+   copy of this software and associated documentation files (the "Software"),
+   to deal in the Software without restriction, including without limitation
+   the rights to use, copy, modify, merge, publish, distribute, sublicense,
+   and/or sell copies of the Software, and to permit persons to whom the
+   Software is furnished to do so, subject to the following conditions:
+
+   The above copyright notice and this permission notice shall be included in
+   all copies or substantial portions of the Software.
+
+   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+   THE AUTHORS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER
+   IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+   CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+   The DMF32 (Unibus) and the DMB32 (VAXBI) run the same microcode
+   functions behind different host interfaces.  This library has the parts
+   that do not depend on the host interface:
+
+   - the line printer formatter (tabs, truncation, line wrap, automatic
+     carriage return, form feed conversion, upper case, non printing
+     characters, DAVFU codes, prefix and suffix characters).
+
+   Each board keeps a COMBO_LP for its printer, sets the option flags from
+   its own registers before a print cycle and supplies the output routine.
+
+   Modification history:
+
+   15-Nov-26    Ulli/Claude  First version: printer formatter (from vax_dmf.c)
+*/
+
+#ifndef VAX_COMBO_LIB_H_
+#define VAX_COMBO_LIB_H_    0
+
+#include "sim_defs.h"
+
+/* Printer formatter options (COMBO_LP.flags) */
+
+#define CLP_TAB         0x0001                  /* expand tabs (every 8 columns) */
+#define CLP_TRUNC       0x0002                  /* truncate long lines */
+#define CLP_AUTOCR      0x0004                  /* CR before LF and FF, strip own CRs */
+#define CLP_FFCONV      0x0008                  /* form feed to line feeds */
+#define CLP_NONPRINT    0x0010                  /* pass non printing characters */
+#define CLP_DAVFU       0x0020                  /* pass DAVFU codes 200-237 */
+#define CLP_WRAP        0x0040                  /* new line at the line end */
+#define CLP_UPPER       0x0080                  /* lower to upper case */
+#define CLP_NLCR        0x0100                  /* "new line" is always CR LF
+                                                   (DMF32); else CR LF only with
+                                                   CLP_AUTOCR, LF alone without
+                                                   (DMB32, UG 3.3.22) */
+
+typedef struct combo_lp COMBO_LP;
+
+struct combo_lp {
+    uint32  flags;                              /* options, CLP_xxx */
+    int32   width;                              /* line width, 0 = no limit */
+    int32   lpp;                                /* lines per page, 0 = unknown */
+    int32   col;                                /* printer column */
+    int32   row;                                /* line on the page */
+    t_bool  crpend;                             /* data CR held (auto CR) */
+    uint32  chars;                              /* characters sent to the printer */
+    uint32  lines;                              /* line feeds (paper movement) */
+    /* the board's output routine: returns TRUE if the character went to the
+       printer (its column and line are then tracked), FALSE if it went
+       elsewhere (DMF32 maintenance mode loops it into a register) */
+    t_bool  (*put)(COMBO_LP *lp, int32 c);
+    void    *ctx;                               /* for the board */
+    };
+
+void combo_lp_reset (COMBO_LP *lp);             /* top of form, column 0 */
+void combo_lp_out (COMBO_LP *lp, int32 c);      /* one character, unformatted */
+void combo_lp_newline (COMBO_LP *lp);           /* "new line" (prefix 0, wrap) */
+void combo_lp_format (COMBO_LP *lp, int32 c);   /* one data character, formatted */
+void combo_lp_fix (COMBO_LP *lp, int32 count, int32 c);    /* prefix/suffix */
+
+#endif
diff --git a/VAX/vax_dmb.c b/VAX/vax_dmb.c
new file mode 100644
index 00000000..84a94f32
--- /dev/null
+++ b/VAX/vax_dmb.c
@@ -0,0 +1,1851 @@
+/* vax_dmb.c: DMB32 VAXBI asynchronous/synchronous multiplexer and printer port
+
+   Permission is hereby granted, free of charge, to any person obtaining a
+   copy of this software and associated documentation files (the "Software"),
+   to deal in the Software without restriction, including without limitation
+   the rights to use, copy, modify, merge, publish, distribute, sublicense,
+   and/or sell copies of the Software, and to permit persons to whom the
+   Software is furnished to do so, subject to the following conditions:
+
+   The above copyright notice and this permission notice shall be included in
+   all copies or substantial portions of the Software.
+
+   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+   THE AUTHORS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER
+   IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+   CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+   dmb          DMB32 (T1012) - VAXBI eight-line asynchronous multiplexer,
+                synchronous line and line printer port
+
+   References:
+     EK-DMB32-UG-001  DMB32 User Guide (registers: chapter 3)
+     EK-DMB32-TD-001  DMB32 Technical Description (DMA address translation,
+                      interrupt vectors: chapter 2)
+     $DMBDEF          VMS V4.7 register definitions ("BICOMBO")
+
+   The DMB32 is the VAXBI relative of the DMF32: the same three functions
+   (no parallel interface) on one BI node, controlled by an on-board 68000.
+   The host sees the node's 8 Kbyte register space:
+
+     base+000  BIIC registers: DTYPE (0109), BICSR, BER, EINTRCSR, INTRDES,
+               IPINTR registers, SADR/EADR, UINTRCSR; base+0F0 GPR0 (self-test
+               summary)
+     base+100  MAINT, ACSR, SCSR, PCSR, CONFIG, ACSR2, SCSR2, PCSR2
+     base+150  SPTE, SPTS, GPTE, GPTS (page tables for DMA translation)
+     base+160  printer registers
+     base+180  sync line registers (indexed by SCSR<7:0>)
+     base+1C0  async line registers (indexed by ACSR<7:0>)
+     base+204  TBUF, SBUF, RBUF completion and receive FIFOs: a read does
+               not remove the entry (VAXBI rule), a write does
+     base+218  on-board RAM, visible only in maintenance mode
+
+   Interrupts go out at BR4 (IPL 14) with a vector the board supplies itself:
+   100 + type*40 + node*4, type 0 = BIIC error, 1 = sync, 2 = async,
+   3 = printer.
+
+   DMA: the board walks the VAX page tables itself (TD 2.2.2).  A buffer is
+   given as a physical address, the physical address of its page table, a
+   system virtual address, or the system virtual address of its process page
+   table, plus a byte offset within the first page for the two page table
+   forms.
+
+   This file has the BI node, the self-test, the async lines and the DMA
+   engine.  The printer port and the synchronous line use the shared
+   printer formatter and DDCMP engine (vax_combo_lib.c, with the DMF32).
+
+   Modification history:
+
+   15-Nov-26    Ulli/Claude  First version (BI node, self-test, async lines)
+*/
+
+#if !defined (VAX_820)
+#error "DMB32 is only supported on the VAX 8200/8300 (VAXBI)"
+#endif
+
+#include "vax_defs.h"
+#include "vax_bi.h"
+#include "sim_tmxr.h"
+#include "vax_combo_lib.h"                     /* printer formatter (with DMF32) */
+
+/* ---------------------------------------------------------------------------
+   Sizes
+   --------------------------------------------------------------------------- */
+
+#define DMB_LINES       8                       /* asynchronous lines */
+#define DMB_RXFIFO      256                     /* received character FIFO */
+#define DMB_RXALARM     ((DMB_RXFIFO * 3) / 4)  /* "critically full": XOFF, interrupt */
+#define DMB_RXEASED     (DMB_RXFIFO / 4)        /* congestion over: XON */
+#define DMB_TXFIFO      32                      /* transmit completion FIFO */
+#define DMB_SFIFO       16                      /* sync completion FIFO */
+#define DMB_NODESPACE   0x2000                  /* node space size */
+#define DMB_RAM_BASE    0x218                   /* on-board RAM (maintenance) */
+#define DMB_RAM_LONGS   ((DMB_NODESPACE - DMB_RAM_BASE) / 4)
+#define DMB_DEF_NODE    5                       /* default BI node (decision D2) */
+#define DMB_DEF_STMS    50                      /* default self-test time, ms (D4) */
+#define DMB_DTYPE       0x0109                  /* device type */
+#define DMB_REVCODE     0x0001                  /* revision (DTYPE<31:16>) */
+
+/* ---------------------------------------------------------------------------
+   Register offsets (bytes from the node base)
+   --------------------------------------------------------------------------- */
+
+#define OF_DTYPE        0x000                   /* BIIC */
+#define OF_BICSR        0x004
+#define OF_BER          0x008
+#define OF_EICR         0x00C
+#define OF_IDEST        0x010
+#define OF_IMSK         0x014
+#define OF_FIDEST       0x018
+#define OF_ISRC         0x01C
+#define OF_SADR         0x020
+#define OF_EADR         0x024
+#define OF_BCICSR       0x028
+#define OF_WSTAT        0x02C
+#define OF_FIPSCMD      0x030
+#define OF_UINTRCSR     0x040
+#define OF_GPR0         0x0F0
+#define OF_GPR3         0x0FC
+#define OF_MAINT        0x100                   /* DMB32 (CASRAM) */
+#define OF_ACSR         0x104
+#define OF_SCSR         0x108
+#define OF_PCSR         0x10C
+#define OF_CONFIG       0x114
+#define OF_ACSR2        0x118
+#define OF_SCSR2        0x11C
+#define OF_PCSR2        0x120
+#define OF_SPTE         0x150
+#define OF_SPTS         0x154
+#define OF_GPTE         0x158
+#define OF_GPTS         0x15C
+#define OF_PFIX         0x160                   /* printer */
+#define OF_PBUFFAD      0x164
+#define OF_PBUFFCT      0x168
+#define OF_PCTRL        0x16C
+#define OF_PCAR         0x170
+#define OF_PSIZE        0x174
+#define OF_SYNC         0x180                   /* sync, 0x180-0x1BC, indexed */
+#define OF_SYNC_END     0x1BC
+#define OF_PREEMPT      0x1C0                   /* async, indexed by ACSR<7:0> */
+#define OF_TBUFFAD      0x1C4
+#define OF_TBUFFCT      0x1C8
+#define OF_LPR          0x1CC
+#define OF_LNCTRL       0x1D0
+#define OF_LSTAT        0x1D4
+#define OF_FLOWC        0x1D8
+#define OF_RXCD         0x200                   /* console register: NO ACK */
+#define OF_TBUF         0x204                   /* FIFOs */
+#define OF_SBUF         0x208
+#define OF_RBUF         0x20C
+
+/* sync registers: index of the longword from OF_SYNC */
+#define SY_TBUFFAD1     0
+#define SY_TBUFFCT1     1
+#define SY_RBUFFAD1     2
+#define SY_RBUFFCT1     3
+#define SY_TLNCTRL1     4
+#define SY_RLNCTRL1     5
+#define SY_LPR1         6
+#define SY_LPR2         7
