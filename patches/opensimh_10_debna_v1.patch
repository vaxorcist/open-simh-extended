+    { HRDATAD (BER,      et_biic.ber,    32, "BI bus error") },
+    { HRDATAD (EINTRCSR, et_biic.eicr,   32, "BI error interrupt control") },
+    { HRDATAD (INTRDES,  et_biic.idest,  16, "BI interrupt destination") },
+    { HRDATAD (BCICSR,   et_biic.bcic,   32, "BCI control and status") },
+    { HRDATAD (UINTRCSR, et_biic.uiic,   32, "BI user interrupt control") },
+    { GRDATA  (NODE,     et_dib.ba, 16, 4, 0), REG_HRO },
+    { NULL }
+    };
+
+MTAB et_mod[] = {
+    { MTAB_XTD|MTAB_VDV|MTAB_VALR, 0, "NODE", "NODE=n",
+      &et_set_node, &et_show_node, NULL, "BI node number (2-15, default 7)" },
+    { MTAB_XTD|MTAB_VDV|MTAB_VALR, 0, "MAC", "MAC=xx:xx:xx:xx:xx:xx",
+      &et_set_mac, &et_show_mac, NULL, "Ethernet hardware address" },
+    { MTAB_XTD|MTAB_VDV|MTAB_NMO, 0, "ETH", NULL,
+      NULL, &eth_show, NULL, "Show the host's Ethernet interfaces" },
+    { 0 }
+    };
+
+DEBTAB et_debug[] = {
+    { "REG",  DBG_REG,  "register access" },
+    { "PORT", DBG_PORT, "port instructions and states" },
+    { "QUE",  DBG_QUE,  "queue entries" },
+    { "XMT",  DBG_XMT,  "transmit" },
+    { "RCV",  DBG_RCV,  "receive" },
+    { "MSG",  DBG_MSG,  "messages" },
+    { "INT",  DBG_INT,  "interrupts" },
+    { "PCK",  DBG_PCK,  "packet headers" },
+    { "DATA", DBG_DAT,  "packet data, DMA" },
+    { "ETH",  DBG_ETH,  "Ethernet transport" },
+    { NULL }
+    };
+
+DEVICE et_dev = {
+    "ET", et_unit, et_reg, et_mod,
+    3, 16, 32, 1, 16, 8,
+    NULL, NULL, &et_reset,
+    NULL, &et_attach, &et_detach,
+    &et_dib, DEV_NEXUS | DEV_DISABLE | DEV_DIS | DEV_DEBUG | DEV_ETHER,
+    0, et_debug, NULL, NULL, &et_help, &et_help_attach, NULL,
+    &et_description
+    };
+
+/* Node and interrupts */
+
+static int32 et_node (void)
+{
+return (int32) (et_dib.ba & 0xF);
+}
+
+static void et_update_int (void)
+{
+int32 l;
+
+for (l = 0; l < NEXUS_HLVL; l++)                /* the level may change */
+    nexus_req[l] &= ~(1u << et_node ());
+if (et_irq && et_vector && !(et_dev.flags & DEV_DIS))
+    nexus_req[et_ipl - IPL_HMIN] |= (1u << et_node ());
+}
+
+int32 et_ack (void)
+{
+if (!et_irq)
+    return 0;                                   /* passive release */
+et_irq = FALSE;
+sim_debug (DBG_INT, &et_dev, "interrupt acknowledge, vector %03X\n", et_vector);
+return (int32) et_vector;
+}
+
+/* Post a status change in PS (OWN) and interrupt */
+
+static void et_post (uint32 bits)
+{
+et_ps |= PS_OWN | bits;
+if (et_vector) {
+    et_irq = TRUE;
+    sim_debug (DBG_INT, &et_dev, "interrupt request, PS %08X\n", et_ps);
+    }
+et_update_int ();
+}
+
+static void et_set_state (uint32 st)
+{
+et_ps = (et_ps & ~PS_PST) | (st << PS_V_PST);
+sim_debug (DBG_PORT, &et_dev, "port state %s\n",
+           (st == PST_UNDEF) ? "UNDEFINED" : (st == PST_INIT) ? "INITIALIZED" :
+           (st == PST_ENABLED) ? "ENABLED" : (st == PST_STOPPED) ? "STOPPED" : "MAINT");
+}
+
+static uint32 et_state (void)
+{
+return (et_ps >> PS_V_PST) & PS_M_PST;
+}
+
+/* A port logical error: the port stops (BVP: error -> STOPPED) */
+
+static void et_port_error (uint32 code, uint32 data)
+{
+sim_debug (DBG_PORT, &et_dev, "port error %02X, data %08X\n", code, data);
+et_pe = code;
+et_pd = data;
+et_ps = (et_ps & ~(PS_M_ETYPE << PS_V_ETYPE)) | (ETY_PLE << PS_V_ETYPE) | PS_SUME;
+et_set_state (PST_STOPPED);
+et_post (0);
+}
+
+/* Host memory by system virtual address */
+
+static t_bool et_vxfer (uint32 va, uint8 *buf, int32 n, t_bool wr)
+{
+BI_DMA d;
+int32 err;
+
+bi_dma_setup (&d, va, 0, (uint32) n, 0, &et_pt, &et_dev, DBG_DAT);
+if (bi_dma_xfer (&d, buf, n, wr, &err) != n) {
+    sim_debug (DBG_PORT, &et_dev, "memory error %02X at %08X (va %08X)\n",
+               err, d.err_addr, va);
+    return FALSE;
+    }
+return TRUE;
+}
+
+static t_bool et_vrl (uint32 va, uint32 *val)
+{
+uint8 b[4];
+
+if (!et_vxfer (va, b, 4, FALSE))
+    return FALSE;
+*val = b[0] | (b[1] << 8) | (b[2] << 16) | ((uint32) b[3] << 24);
+return TRUE;
+}
+
+static t_bool et_vwl (uint32 va, uint32 val)
+{
+uint8 b[4];
+
+b[0] = (uint8) val; b[1] = (uint8) (val >> 8);
+b[2] = (uint8) (val >> 16); b[3] = (uint8) (val >> 24);
+return et_vxfer (va, b, 4, TRUE);
+}
+
+#define GW(b,o)  ((uint32) ((b)[o] | ((b)[(o) + 1] << 8)))
+#define GL(b,o)  ((uint32) ((b)[o] | ((b)[(o) + 1] << 8) | ((b)[(o) + 2] << 16) | ((uint32) (b)[(o) + 3] << 24)))
+#define PW(b,o,v) { (b)[o] = (uint8) (v); (b)[(o) + 1] = (uint8) ((v) >> 8); }
+#define PL(b,o,v) { PW (b, o, v); PW (b, (o) + 2, (v) >> 16); }
+
+/* Self-relative interlocked queues (as the VAX instructions INSQTI and
+   REMQHI see them).  The CPU executes those instructions atomically here,
+   so a set secondary interlock means another agent holds the queue: the
+   port then tries again later. */
+
+#define Q_OK        0
+#define Q_EMPTY     1
+#define Q_BUSY      2
+#define Q_ERR       3
+
+static int32 et_remqhi (uint32 h, uint32 *ent)
+{
+uint32 hf, ef, e, nx;
+
+if (!et_vrl (h, &hf))
+    return Q_ERR;
+if (hf & 1)
+    return Q_BUSY;
+if (hf == 0)
+    return Q_EMPTY;
+e = h + hf;
+if (!et_vrl (e, &ef))
+    return Q_ERR;
+nx = e + ef;
+if (nx == h) {                                  /* now empty */
+    if (!et_vwl (h, 0) || !et_vwl (h + 4, 0))
+        return Q_ERR;
+    }
+else {
+    if (!et_vwl (h, nx - h) || !et_vwl (nx + 4, h - nx))
+        return Q_ERR;
+    }
+*ent = e;
+return Q_OK;
+}
+
+static int32 et_insqti (uint32 e, uint32 h, t_bool *first)
+{
+uint32 hf, hb, last;
+
+if (!et_vrl (h, &hf) || !et_vrl (h + 4, &hb))
+    return Q_ERR;
+if (hf & 1)
+    return Q_BUSY;
+*first = (hf == 0);
+if (hf == 0) {
+    if (!et_vwl (e, h - e) || !et_vwl (e + 4, h - e) ||
+        !et_vwl (h, e - h) || !et_vwl (h + 4, e - h))
+        return Q_ERR;
+    return Q_OK;
+    }
+last = h + hb;
+if (!et_vwl (e, h - e) || !et_vwl (e + 4, last - e) ||
+    !et_vwl (last, e - last) || !et_vwl (h + 4, e - h))
+    return Q_ERR;
+return Q_OK;
+}
+
+static uint32 et_fq_hdr (uint32 q)
+{
+return et_fqb_va + q * FQB_SIZE + FQB_HDR;
+}
+
+/* Queue an entry on the response queue and tell the host */
+
+static void et_respond (uint32 e)
+{
+t_bool first;
+int32 r;
+
+r = et_insqti (e, et_pqb_va + PQB_RSPQ, &first);
+if (r == Q_BUSY) {                              /* cannot happen with VMS */
+    sim_debug (DBG_QUE, &et_dev, "response queue interlocked, entry %08X lost\n", e);
+    et_ps |= PS_ERL;
+    return;
+    }
+if (r != Q_OK) {
+    et_port_error (PE_PQB, et_pqb_va + PQB_RSPQ);
+    return;
+    }
+sim_debug (DBG_QUE, &et_dev, "response %08X queued%s\n", e, first ? " (first)" : "");
+if (!(et_ps & PS_RSQ) || !(et_ps & PS_OWN))
+    et_post (PS_RSQ);
+}
+
+/* Return an entry to a free queue */
+
+static void et_free (uint32 e, uint32 q)
+{
+t_bool first;
+
+if ((q >= et_nfq) || (et_insqti (e, et_fq_hdr (q), &first) != Q_OK))
+    sim_debug (DBG_QUE, &et_dev, "cannot return %08X to free queue %d\n", e, q);
+}
+
+/* Debug: an entry's first bytes */
+
+static void et_dump (const char *what, uint32 e, const uint8 *b, int32 n)
+{
+int32 i;
+
+if (!sim_deb || !(et_dev.dctrl & DBG_QUE))
+    return;
+sim_debug (DBG_QUE, &et_dev, "%s %08X:", what, e);
+for (i = 0; i < n; i++)
+    sim_debug (DBG_QUE, &et_dev, "%s%02X", ((i & 15) == 0) ? "\n    " : " ", b[i]);
+sim_debug (DBG_QUE, &et_dev, "\n");
+}
+
+/* Buffer descriptor: set up DMA for item bytes [off, off+len) of BDT entry x */
+
+static t_bool et_bd_dma (BI_DMA *d, uint32 x, uint32 off, uint32 len)
+{
+uint8 bd[BD_SIZE];
+uint32 st;
+
+if ((x >= et_nbdt) || !et_vxfer (et_bdt_va + x * BD_SIZE, bd, BD_SIZE, FALSE))
+    return FALSE;
+st = GW (bd, BD_STATUS);
+if (!(st & BDS_VALID)) {
+    sim_debug (DBG_QUE, &et_dev, "BDT entry %d not valid\n", x);
+    return FALSE;
+    }
+bi_dma_setup (d, GL (bd, BD_PTE), (st & BDS_OFFSET) + off, len, BIDMA_PTE,
+              &et_pt, &et_dev, DBG_DAT);
+return TRUE;
+}
+
+static uint32 et_bd_len (uint32 x)
+{
+uint8 bd[BD_SIZE];
+
+if ((x >= et_nbdt) || !et_vxfer (et_bdt_va + x * BD_SIZE, bd, BD_SIZE, FALSE))
+    return 0;
+return GL (bd, BD_LEN);
+}
+
+/* Register access (longword registers; the CPU picks bytes and words) */
+
+t_stat et_rd (int32 *val, int32 pa, int32 lnt)
+{
+int32 ofs = pa & 0x1FFC;
+uint32 v;
+
+switch (ofs) {
+    case EOF_DTYPE:    v = ET_DTYPE; break;
+    case EOF_BICSR:    v = et_biic.csr & BICSR_RD; break;
+    case EOF_BER:      v = et_biic.ber; break;
+    case EOF_EICR:     v = et_biic.eicr & BIECR_RD; break;
+    case EOF_IDEST:    v = et_biic.idest & BIID_RD; break;
+    case EOF_IMSK:     v = et_biic.imsk & 0xFFFF0000; break;
+    case EOF_FIDEST:   v = et_biic.fidest & 0xFFFF0000; break;
+    case EOF_ISRC:     v = et_biic.isrc & 0xFFFF0000; break;
+    case EOF_SADR:     v = et_biic.sa & 0x3FFC0000; break;
+    case EOF_EADR:     v = et_biic.ea & 0x3FFC0000; break;
+    case EOF_BCICSR:   v = et_biic.bcic; break;
+    case EOF_UINTRCSR: v = et_biic.uiic & BIICR_RD; break;
+    case EOF_RXCD:     v = 0; break;            /* no console traffic */
+    case EOF_PC:       v = et_pc; break;
+    case EOF_PS:       v = et_ps; break;
+    case EOF_PE:       v = et_pe; break;
+    case EOF_PD:       v = et_pd; break;
+    case EOF_PUDR:     v = (et_ps & PS_STD) ? ET_PUDR : 0; break;
+    case EOF_ADDR0:
+        v = et_mac[0] | (et_mac[1] << 8) | (et_mac[2] << 16) | ((uint32) et_mac[3] << 24);
+        break;
+    case EOF_ADDR1:    v = et_mac[4] | (et_mac[5] << 8); break;
+    default:
+        if (ofs < 0x100)                        /* BIIC (GPRs: no tape port) */
+            v = 0;
+        else if (ofs < 0x220)
+            v = 0;
+        else
+            return SCPE_NXM;
+        break;
+    }
+*val = (int32) v;
+sim_debug (DBG_REG, &et_dev, "et_rd (%03X) = %08X\n", pa & 0x1FFF, v);
+return SCPE_OK;
+}
+
+t_stat et_wr (int32 val, int32 pa, int32 lnt)
+{
+int32 ofs = pa & 0x1FFC;
+uint32 data = (uint32) val;
+uint32 old = 0;
+
+sim_debug (DBG_REG, &et_dev, "et_wr (%03X, %d bytes) = %08X\n", pa & 0x1FFF,
+           (lnt == L_BYTE) ? 1 : ((lnt == L_WORD) ? 2 : 4), data);
+switch (ofs) {                                  /* merge partial writes */
+    case EOF_BICSR: old = et_biic.csr; break;
+    case EOF_PC:    old = et_pc; break;
+    case EOF_PS:    old = et_ps; break;
+    case EOF_PE:    old = et_pe; break;
+    case EOF_PD:    old = et_pd; break;
+    default:        old = 0; break;
+    }
+if (lnt != L_LONG) {
+    int32 sc = (pa & 3) << 3;
+    uint32 m = ((lnt == L_BYTE) ? 0xFFu : 0xFFFFu) << sc;
+
+    data = (old & ~m) | ((data << sc) & m);
+    }
+switch (ofs) {
+    case EOF_BICSR:
+        if (data & BICSR_RST) {                 /* node reset: self-test */
+            et_biic.csr = (et_biic.csr & ~BICSR_RW) | (data & BICSR_RW & ~BICSR_RST);
+            sim_debug (DBG_PORT, &et_dev, "node reset\n");
+            et_biic.csr = (et_biic.csr | BICSR_BRK) & ~BICSR_STS;
+            et_ps = 0;                          /* self-test in progress */
+            et_pc = 0;
+            et_pe = et_pd = 0;
+            et_vector = 0;
+            et_irq = FALSE;
+            et_pt.valid = FALSE;
+            memset (et_ptdb, 0, sizeof (et_ptdb));
+            et_set_filter ();
+            et_update_int ();
+            sim_cancel (&et_unit[2]);
+            sim_activate_after (&et_unit[1], ET_SELFTEST);
+            break;
+            }
+        et_biic.csr = (et_biic.csr & ~BICSR_RW) | (data & BICSR_RW);
+        et_biic.csr &= ~(data & BICSR_UWP);      /* write 1 to clear */
+        break;
+    case EOF_BER:      et_biic.ber &= ~(data & BIBER_W1C); break;
+    case EOF_EICR:
+        et_biic.eicr = (et_biic.eicr & ~BIECR_RW) | (data & BIECR_RW);
+        et_biic.eicr &= ~(data & BIECR_W1C);
+        break;
+    case EOF_IDEST:    et_biic.idest = data & BIID_RW; break;
+    case EOF_IMSK:     et_biic.imsk = data & 0xFFFF0000; break;
+    case EOF_FIDEST:   et_biic.fidest = data & 0xFFFF0000; break;
+    case EOF_ISRC:     et_biic.isrc &= ~(data & 0xFFFF0000); break;
+    case EOF_SADR:     et_biic.sa = data & 0x3FFC0000; break;
+    case EOF_EADR:     et_biic.ea = data & 0x3FFC0000; break;
+    case EOF_BCICSR:   et_biic.bcic = data; break;
+    case EOF_UINTRCSR:
+        et_biic.uiic = ((et_biic.uiic & ~BIICR_RW) | (data & BIICR_RW)) & ~(data & BIICR_W1C);
+        break;
+    case EOF_PC:                                /* the port takes it a little */
+        et_pc = data;                           /* later (VMS gives PS back first) */
+        if ((et_pc & PC_OWN) && (et_ps & PS_STD))
+            sim_activate (&et_unit[2], ET_PCDELAY);
+        break;
+    case EOF_PS:                                /* the host gives OWN, RSQ back */
+        et_ps = (et_ps & ~(PS_OWN|PS_RSQ)) | (data & et_ps & (PS_OWN|PS_RSQ));
+        if (!(et_ps & PS_OWN)) {
+            et_irq = FALSE;
+            et_ps &= ~(PS_SUME | (PS_M_ETYPE << PS_V_ETYPE) | PS_RPSQ);
+            }
+        if (!(et_ps & PS_RSQ) && (et_state () == PST_ENABLED)) {  /* anything left? */
+            uint32 f;
+
+            if (et_vrl (et_pqb_va + PQB_RSPQ, &f) && (f != 0))
+                et_post (PS_RSQ);
+            }
+        et_update_int ();
+        break;
+    case EOF_PE:       et_pe = data; break;
+    case EOF_PD:       et_pd = data; break;
+    default:
+        if (ofs >= 0x220)
+            return SCPE_NXM;
+        break;
+    }
+return SCPE_OK;
+}
+
+/* Self-test done */
+
+t_stat et_st_svc (UNIT *uptr)
+{
+et_biic.csr = (et_biic.csr & ~BICSR_BRK) | BICSR_STS;
+et_ps = PS_STD | PS_ACC | (PST_UNDEF << PS_V_PST);
+et_pe = et_pd = 0;
+sim_debug (DBG_PORT, &et_dev, "self-test done\n");
+return SCPE_OK;
+}
+
+/* The port takes an instruction */
+
+t_stat et_pc_svc (UNIT *uptr)
+{
+if ((et_pc & PC_OWN) && (et_ps & PS_STD))
+    et_port_instr ();
+return SCPE_OK;
+}
+
+/* Load the PQB (INIT) */
+
+static t_bool et_load_pqb (uint32 pa)
+{
+uint32 w, vfqb, fq;
+
+et_pqb_pa = pa;
+if (!bi_mem_rl (pa + PQB_SPT, &et_pt.spte) || !bi_mem_rl (pa + PQB_SPTLEN, &et_pt.spts) ||
+    !bi_mem_rl (pa + PQB_GPT, &et_pt.gpte) || !bi_mem_rl (pa + PQB_GPTLEN, &et_pt.gpts) ||
+    !bi_mem_rl (pa + PQB_VPQB, &et_pqb_va) || !bi_mem_rl (pa + PQB_VBDT, &et_bdt_va) ||
+    !bi_mem_rl (pa + PQB_NBDT, &et_nbdt) || !bi_mem_rl (pa + PQB_VFQB, &vfqb) ||
+    !bi_mem_rl (pa + PQB_FREEQ, &fq) || !bi_mem_rl (pa + PQB_VECLVL, &w))
+    return FALSE;
+et_pt.spte &= 0x3FFFFFFF;
+et_pt.valid = TRUE;
+et_fqb_va = vfqb;
+et_nfq = (fq > FQ_MAX) ? FQ_MAX : fq;
+et_qe_max = 0;
+for (fq = 0; fq < FQ_MAX; fq++) {               /* entry lengths */
+    if (!et_vrl (et_fqb_va + fq * FQB_SIZE + FQB_LEN, &w))
+        return FALSE;
+    et_fq_len[fq] = (w > QE_SIZE) ? QE_SIZE : w;
+    if (et_fq_len[fq] > et_qe_max)
+        et_qe_max = et_fq_len[fq];
+    }
+if (et_qe_max < QE_DG_BUFS + 8)
+    et_qe_max = QE_DG_BUFS + 8;
+if (!bi_mem_rl (pa + PQB_VECLVL, &w))
+    return FALSE;
+et_veclvl = w & 0xFFFF;
+et_vector = (et_veclvl >> 2) & 0x3FFC;          /* <15:2> vector, <1:0> level */
+et_ipl = 0x13 + (et_veclvl & 3);                /* 1-3 = BR4-BR6 (VMS: 2, vector 15C */
+if (et_ipl < IPL_HMIN)                          /* = BR5 slot of node 7) */
+    et_ipl = IPL_HMIN;
+sim_debug (DBG_PORT, &et_dev, "PQB %08X (va %08X): veclvl %04X (vector %03X, IPL %02X), node word %04X,\n"
+           "    free queues %d at %08X, BDT %08X (%d), SPT %08X/%d, GPT %08X/%d\n",
+           pa, et_pqb_va, et_veclvl, et_vector, et_ipl, w >> 16, fq, et_fqb_va,
+           et_bdt_va, et_nbdt, et_pt.spte, et_pt.spts, et_pt.gpte, et_pt.gpts);
+if (sim_deb && (et_dev.dctrl & DBG_QUE)) {      /* the whole PQB, to trace */
+    uint8 b[0x100];
+    int32 i;
+
+    for (i = 0; i < 0x100; i += 4) {
+        bi_mem_rl (pa + i, &w);
+        PL (b, i, w);
+        }
+    et_dump ("PQB", pa, b, 0x100);
+    if (et_vxfer (et_fqb_va, b, FQ_MAX * FQB_SIZE, FALSE))
+        et_dump ("FQB", et_fqb_va, b, FQ_MAX * FQB_SIZE);
+    }
+return TRUE;
+}
+
+/* A port instruction */
+
+static void et_port_instr (void)
+{
+uint32 ins = et_pc & PC_INS;
+uint32 q = (et_pc >> PC_V_QUE) & PC_M_QUE;
+uint32 st = et_state ();
+
+sim_debug (DBG_PORT, &et_dev, "instruction %d, queue %d, PC %08X, state %d\n", ins, q, et_pc, st);
+et_pc &= ~PC_OWN;                               /* taken */
+switch (ins) {
+    case PCI_INIT:
+        if ((st != PST_UNDEF) && (st != PST_STOPPED)) {
+            et_port_error (PE_INSSTATE, et_ps);
+            return;
+            }
+        if (!et_load_pqb (et_pc & ~0x1FF)) {
+            et_port_error (PE_PQB, et_pc & ~0x1FF);
+            return;
+            }
+        et_ps &= ~(PS_SUME | (PS_M_ETYPE << PS_V_ETYPE) | PS_FQE | PS_ERL | PS_RSQ);
+        et_pe = et_pd = 0;
+        et_set_state (PST_INIT);
+        et_post (0);
+        break;
+    case PCI_ENABLE:
+        if (st != PST_INIT) {
+            et_port_error (PE_INSSTATE, et_ps);
+            return;
+            }
+        et_set_state (PST_ENABLED);
+        et_post (0);
+        if (et_unit[0].flags & UNIT_ATT)
+            sim_clock_coschedule (&et_unit[0], et_poll);
+        break;
+    case PCI_SHUTDOWN:
+        et_set_state (PST_UNDEF);
+        memset (et_ptdb, 0, sizeof (et_ptdb));
+        et_set_filter ();
+        et_post (0);
+        break;
+    case PCI_CMDQNE:
+        if (st != PST_ENABLED) {
+            et_port_error (PE_INSSTATE, et_ps);
+            return;
+            }
+        et_work_cmdq (q);
+        break;
+    case PCI_FREEQNE:
+        if (st == PST_ENABLED)
+            et_deliver ();
+        break;
+    default:
+        et_port_error (PE_ILLINS, ins);
+        break;
+    }
+}
+
+/* Transmit a datagram */
+
+static void et_transmit (uint32 e, uint8 *b)
+{
+uint32 n = 0, i, item, x, len, off, flags = b[QE_FLAGS], ptdbx = GL (b, QE_DG_PTDBX);
+uint32 status = 0;
+BI_DMA d;
+int32 err;
+
+for (i = 0; i < DGB_MAX; i++) {
+    item = QE_DG_BUFS + i * 8;
+    if ((item + 8) > et_qe_max) {
+        status = 0x11;
+        break;
+        }
+    off = GW (b, item);
+    len = GW (b, item + 2);
+    x = GW (b, item + 4);
+    if ((n + len) > ETH_MAX_PACKET) {
+        status = 0x11;                          /* too long */
+        break;
+        }
+    if (len && (!et_bd_dma (&d, x & DGB_INDEX, off, len) ||
+        (bi_dma_xfer (&d, et_wbuf.msg + n, (int32) len, FALSE, &err) != (int32) len))) {
+        status = 0x13;                          /* buffer error */
+        break;
+        }
+    n += len;
+    if (!(x & DGB_CHAIN))
+        break;
+    }
+if ((status == 0) && (n < 14))
+    status = 0x11;
+if (status == 0) {
+    if (n < ETH_MIN_PACKET) {                   /* the LANCE pads */
+        memset (et_wbuf.msg + n, 0, ETH_MIN_PACKET - n);
+        n = ETH_MIN_PACKET;
+        }
+    et_wbuf.len = n;
+    sim_debug (DBG_XMT, &et_dev, "transmit %d bytes, type %02X%02X, to %02X-%02X-%02X-%02X-%02X-%02X\n",
+               n, et_wbuf.msg[12], et_wbuf.msg[13], et_wbuf.msg[0], et_wbuf.msg[1],
+               et_wbuf.msg[2], et_wbuf.msg[3], et_wbuf.msg[4], et_wbuf.msg[5]);
+    if (et_eth) {
+        if (sim_deb && (et_dev.dctrl & DBG_PCK))
+            eth_packet_trace_ex (et_eth, et_wbuf.msg, et_wbuf.len, "et-write", et_dev.dctrl & DBG_DAT, DBG_PCK);
+        if (eth_write (et_eth, &et_wbuf, NULL) != SCPE_OK) /* a host side error (e.g. */
+            sim_debug (DBG_XMT, &et_dev, "host transport error\n"); /* no UDP partner) is */
+        }                                       /* not a send failure on the cable */
+    if (status == 0) {                          /* (no cable: it goes nowhere) */
+        et_cnt[CNT_XBYTES] += n;
+        et_cnt[CNT_XFRAMES]++;
+        if (et_wbuf.msg[0] & 1) {
+            et_cnt[CNT_XMBYTES] += n;
+            et_cnt[CNT_XMFRAMES]++;
+            }
+        }
+    }
+else
+    sim_debug (DBG_XMT, &et_dev, "transmit failed, status %02X\n", status);
+if (flags & QEF_R) {                            /* respond */
+    uint8 s = (uint8) status, z = 0;
+
+    et_vxfer (e + QE_STATUS, &z, 1, TRUE);
+    et_vxfer (e + QE_DG_XSTS, &s, 1, TRUE);     /* VMS reads it here */
+    et_respond (e);
+    }
+else {                                          /* back to its free queue */
+    ET_PTDB *p = et_find_ptdb (ptdbx, FALSE);
+
+    et_free (e, p ? p->fque : FQ_DG);
+    }
+}
+
+/* PTDB table */
+
+static ET_PTDB *et_find_ptdb (uint32 index, t_bool alloc)
+{
+int32 i;
+
+for (i = 0; i < ET_MAXPTDB; i++)                /* the host's index is any */
+    if (et_ptdb[i].valid && (et_ptdb[i].index == index))   /* longword (VMS: an */
+        return &et_ptdb[i];                     /* address) */
+if (alloc)
+    for (i = 0; i < ET_MAXPTDB; i++)
+        if (!et_ptdb[i].valid)
+            return &et_ptdb[i];
+return NULL;
+}
+
+/* sim_ether filter from the PTDBs */
+
+static void et_set_filter (void)
+{
+ETH_MAC f[ETH_FILTER_MAX];
+int32 n = 0, i, j, k;
+t_bool prom = FALSE, amc = FALSE;
+
+if (!et_eth)
+    return;
+memcpy (f[n++], et_apa, sizeof (ETH_MAC));
+if (memcmp (et_apa, et_mac, sizeof (ETH_MAC)))  /* the hardware address too */
+    memcpy (f[n++], et_mac, sizeof (ETH_MAC));
+for (i = 0; i < ET_MAXPTDB; i++) {
+    ET_PTDB *p = &et_ptdb[i];
+
+    if (!p->valid)
+        continue;
+    prom |= (p->flags & PTDF_PROMISC) != 0;
+    amc |= (p->flags & PTDF_AMC) != 0;
+    if (p->flags & PTDF_BDC) {
+        static ETH_MAC bc = { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF };
+
+        for (k = 0; (k < n) && memcmp (f[k], bc, sizeof (ETH_MAC)); k++) ;
+        if ((k == n) && (n < ETH_FILTER_MAX))
+            memcpy (f[n++], bc, sizeof (ETH_MAC));
+        }
+    for (j = 0; j < p->nmc; j++) {
+        for (k = 0; (k < n) && memcmp (f[k], p->mc[j], sizeof (ETH_MAC)); k++) ;
+        if (k == n) {
+            if (n < ETH_FILTER_MAX)
+                memcpy (f[n++], p->mc[j], sizeof (ETH_MAC));
+            else
+                amc = TRUE;
+            }
+        }
+    }
+eth_filter (et_eth, n, f, amc, prom);
+sim_debug (DBG_RCV, &et_dev, "filter: %d addresses%s%s\n", n,
+           amc ? ", all multicast" : "", prom ? ", promiscuous" : "");
+}
+
+/* A message */
+
+static void et_message (uint32 e, uint8 *b)
+{
+uint32 fn = b[QE_MSG_OPC2];
+uint32 len = GW (b, QE_LEN);
+uint8 *t = b + QE_MSG_TEXT;
+uint8 sts = 0;
+uint32 resp_len = len;
+ET_PTDB *p;
+int32 i;
+
+switch (fn) {
+    case NI_WSYSID:
+        et_sysid_len = (len > 6) ? len - 6 : 0;
+        if (et_sysid_len > sizeof (et_sysid))
+            et_sysid_len = sizeof (et_sysid);
+        memcpy (et_sysid, t, et_sysid_len);
+        sim_debug (DBG_MSG, &et_dev, "write system ID, %d bytes\n", et_sysid_len);
+        break;
+    case NI_RSYSID:
+        memcpy (t, et_sysid, et_sysid_len);
+        resp_len = et_sysid_len + 6;
+        sim_debug (DBG_MSG, &et_dev, "read system ID\n");
+        break;
+    case NI_WPARAM:
+        memcpy (et_param, t, PAR_SIZE);
+        if (memcmp (t + PAR_APA, "\0\0\0\0\0\0", 6))    /* a new address */
+            memcpy (et_apa, t + PAR_APA, sizeof (ETH_MAC));
+        sim_debug (DBG_MSG, &et_dev, "write parameters: flags %08X, address %02X-%02X-%02X-%02X-%02X-%02X\n",
+                   GL (t, PAR_FLAGS), et_apa[0], et_apa[1], et_apa[2], et_apa[3], et_apa[4], et_apa[5]);
+        et_set_filter ();
+        /* fall through: the response carries the parameters */
+    case NI_RPARAM:
+        memset (t, 0, PAR_SIZE);
+        memcpy (t + PAR_DPA, et_mac, sizeof (ETH_MAC));
+        memcpy (t + PAR_APA, et_apa, sizeof (ETH_MAC));
+        memcpy (t + PAR_LSA, et_param + PAR_LSA, 8);
+        memcpy (t + PAR_BVC, et_param + PAR_BVC, 8);
+        PW (t, PAR_MAXADDR, ET_MAXMC);
+        PW (t, PAR_MAXPTT, ET_MAXPTDB);
+        PW (t, PAR_MAXFQ, FQ_MAX);
+        for (i = 0; i < ET_MAXPTDB; i++)
+            if (et_ptdb[i].valid) {
+                PW (t, PAR_CURPTT, GW (t, PAR_CURPTT) + 1);
+                }
+        PW (t, PAR_CURFQ, et_nfq);
+        PL (t, PAR_SID, GL (et_param, PAR_SID));
+        PL (t, PAR_MOP, GL (et_param, PAR_MOP));
+        PL (t, PAR_FLAGS, GL (et_param, PAR_FLAGS));
+        PL (t, PAR_RCTO, GL (et_param, PAR_RCTO));
+        PL (t, PAR_XMTO, GL (et_param, PAR_XMTO));
+        if (fn == NI_RPARAM)
+            sim_debug (DBG_MSG, &et_dev, "read parameters\n");
+        resp_len = PAR_SIZE + 6;
+        break;
+    case NI_RCCNTR:
+    case NI_RDCNTR:
+        memset (t, 0, CNT_SIZE);
+        if (1) {
+            uint32 secs = (uint32) ((sim_os_msec () - et_cnt_zero) / 1000.0);
+
+            PW (t, 0x00, (secs > 0xFFFF) ? 0xFFFF : secs);
+            }
+        for (i = 0; i < CNT_NLONG; i++)
+            PL (t, 0x02 + i * 4, et_cnt[i]);
+        PW (t, 0x36, (et_cnt[CNT_UNRDEST] > 0xFFFF) ? 0xFFFF : et_cnt[CNT_UNRDEST]);
+        PW (t, 0x3A, (et_cnt[CNT_SBUF] > 0xFFFF) ? 0xFFFF : et_cnt[CNT_SBUF]);
+        PW (t, 0x3C, (et_cnt[CNT_UBUF] > 0xFFFF) ? 0xFFFF : et_cnt[CNT_UBUF]);
+        resp_len = CNT_SIZE + 6;
+        sim_debug (DBG_MSG, &et_dev, "read%s counters\n", (fn == NI_RCCNTR) ? " and clear" : "");
+        if (fn == NI_RCCNTR) {
+            memset (et_cnt, 0, sizeof (et_cnt));
+            et_cnt_zero = sim_os_msec ();
+            }
+        break;
+    case NI_STPTDB:
+        p = et_find_ptdb (GL (t, PTD_INDEX), TRUE);
+        if (p == NULL) {
+            sts = 0x01;                         /* table full */
+            break;
+            }
+        p->valid = TRUE;
+        p->index = GL (t, PTD_INDEX);
+        p->type = (uint16) ((t[PTD_TYPE] << 8) | t[PTD_TYPE + 1]);   /* network order */
+        p->fque = t[PTD_FQUE];
+        p->flags = t[PTD_FLAGS];
+        p->sap802 = (uint16) GW (t, PTD_802);
+        p->nmc = (int32) GW (t, PTD_ADRLEN);
+        if (p->nmc > ET_MAXMC)
+            p->nmc = ET_MAXMC;
+        for (i = 0; i < p->nmc; i++)
+            memcpy (p->mc[i], t + PTD_MCAST + i * 8, sizeof (ETH_MAC));
+        sim_debug (DBG_MSG, &et_dev, "set PTDB %X: type %04X, free queue %d, flags %02X, %d addresses\n",
+                   p->index, p->type, p->fque, p->flags, p->nmc);
+        et_set_filter ();
+        break;
+    case NI_CLPTDB:
+        p = et_find_ptdb (GL (t, PTD_INDEX), FALSE);
+        if (p == NULL) {
+            sts = 0x01;
+            break;
+            }
+        sim_debug (DBG_MSG, &et_dev, "clear PTDB %X\n", p->index);
+        memset (p, 0, sizeof (*p));
+        et_set_filter ();
+        break;
+    default:
+        sim_debug (DBG_MSG, &et_dev, "unknown NI function %d\n", fn);
+        sts = 0x03;
+        break;
+    }
+b[QE_STATUS] = sts;
+b[QE_OPCODE] = OPC_MSGRX;
+if ((QE_MSG_TEXT + resp_len - 6) > et_fq_len[FQ_MSG])  /* never past the entry */
+    resp_len = et_fq_len[FQ_MSG] - QE_MSG_TEXT + 6;
+PW (b, QE_LEN, resp_len);
+if (!et_vxfer (e + QE_STATUS, b + QE_STATUS, QE_MSG_TEXT + resp_len - 6 - QE_STATUS, TRUE))
+    return;
+et_respond (e);
+}
+
+/* Work a command queue */
+
+static void et_work_cmdq (int32 q)
+{
+uint32 e;
+uint8 b[QE_SIZE];
+int32 r;
+
+while ((r = et_remqhi (et_pqb_va + PQB_CMDQ0 + q * 8, &e)) == Q_OK) {
+    memset (b, 0, sizeof (b));
+    if (!et_vxfer (e, b, et_qe_max, FALSE)) {
+        et_port_error (PE_PQB, e);
+        return;
+        }
+    et_dump ("command", e, b, 0x40);
+    switch (b[QE_OPCODE]) {
+        case OPC_DGRAM:
+        case OPC_DGRAMI:
+            et_transmit (e, b);
+            break;
+        case OPC_MSG:
+            et_message (e, b);
+            break;
+        default:
+            sim_debug (DBG_QUE, &et_dev, "unknown opcode %d in %08X\n", b[QE_OPCODE], e);
+            b[QE_STATUS] = 0x03;
+            et_vxfer (e + QE_STATUS, &b[QE_STATUS], 1, TRUE);
+            et_respond (e);
+            break;
+        }
+    if (et_state () != PST_ENABLED)
+        return;
+    }
+if (r == Q_BUSY)                                /* try again shortly */
+    sim_activate (&et_unit[0], 100);
+}
+
+/* Receive: which PTDB takes the frame */
+
+static ET_PTDB *et_match (const uint8 *m)
+{
+uint16 type = (uint16) ((m[12] << 8) | m[13]);
+t_bool mc = (m[0] & 1) != 0;
+t_bool bc = mc && (memcmp (m, "\377\377\377\377\377\377", 6) == 0);
+ET_PTDB *unkn = NULL;
+int32 i, j;
+
+for (i = 0; i < ET_MAXPTDB; i++) {
+    ET_PTDB *p = &et_ptdb[i];
+    t_bool addr_ok;
+
+    if (!p->valid)
+        continue;
+    if (p->flags & PTDF_PROMISC)
+        addr_ok = TRUE;
+    else if (bc)
+        addr_ok = (p->flags & PTDF_BDC) != 0;
+    else if (mc) {
+        addr_ok = (p->flags & PTDF_AMC) != 0;
+        for (j = 0; !addr_ok && (j < p->nmc); j++)
+            addr_ok = (memcmp (m, p->mc[j], 6) == 0);
+        }
+    else
+        addr_ok = (memcmp (m, et_apa, 6) == 0) || (memcmp (m, et_mac, 6) == 0);
+    if (!addr_ok)
+        continue;
+    if ((p->flags & PTDF_802) ? (type < 0x600) : (type == p->type))
+        return p;
+    if ((p->flags & PTDF_UNKN) && (unkn == NULL))
+        unkn = p;
+    }
+if (unkn) {                                     /* only if no PTDB has the type */
+    for (i = 0; i < ET_MAXPTDB; i++)
+        if (et_ptdb[i].valid && !(et_ptdb[i].flags & PTDF_802) && (et_ptdb[i].type == type))
+            return NULL;
+    }
+return unkn;
+}
+
+/* Put waiting frames into receive buffers; FALSE if one must wait */
+
+static void et_deliver (void)
+{
+while ((et_rque.count > 0) && (et_state () == PST_ENABLED)) {
+    ETH_ITEM *it = &et_rque.item[et_rque.head];
+    uint8 *m = it->packet.msg;
+    uint32 n = it->packet.crc_len ? it->packet.crc_len : it->packet.len + 4;
+    ET_PTDB *p = et_match (m);
+    uint32 e, x, blen;
+    uint8 b[QE_SIZE];
+    BI_DMA d;
+    int32 r, err;
+
+    if (p == NULL) {                            /* nobody wants it */
+        sim_debug (DBG_RCV, &et_dev, "frame type %02X%02X not taken\n", m[12], m[13]);
+        et_cnt[CNT_UNRDEST]++;
+        ethq_remove (&et_rque);
+        continue;
+        }
+    r = et_remqhi (et_fq_hdr (p->fque), &e);
+    if (r == Q_EMPTY) {                         /* wait for FREEQNE */
+        if (!(et_ps & PS_FQE)) {
+            sim_debug (DBG_RCV, &et_dev, "free queue %d empty\n", p->fque);
+            et_cnt[CNT_UBUF]++;
+            }
+        return;
+        }
+    if (r != Q_OK)
+        return;
+    if (!et_vxfer (e, b, QE_DG_BUFS + 8, FALSE)) {
+        et_port_error (PE_PQB, e);
+        return;
+        }
+    x = GW (b, QE_DG_BUFS + 4) & DGB_INDEX;
+    blen = et_bd_len (x);
+    if (n > blen)
+        n = blen;
+    if (!et_bd_dma (&d, x, GW (b, QE_DG_BUFS), n) ||
+        (bi_dma_xfer (&d, m, (int32) n, TRUE, &err) != (int32) n)) {
+        sim_debug (DBG_RCV, &et_dev, "receive buffer error, BDT entry %d\n", x);
+        b[QE_STATUS] = 0x13;
+        }
+    else
+        b[QE_STATUS] = 0;
+    PW (b, QE_DG_BUFS + 2, n);                  /* length with the CRC */
+    PL (b, QE_DG_PTDBX, p->index);
+    b[QE_OPCODE] = OPC_DGRAMRX;
+    if (et_vxfer (e, b, QE_DG_BUFS + 8, TRUE)) {
+        sim_debug (DBG_RCV, &et_dev, "received %d bytes, type %02X%02X, PTDB %X, entry %08X\n",
+                   n, m[12], m[13], p->index, e);
+        et_cnt[CNT_RBYTES] += n - 4;
+        et_cnt[CNT_RFRAMES]++;
+        if (m[0] & 1) {
+            et_cnt[CNT_RMBYTES] += n - 4;
+            et_cnt[CNT_RMFRAMES]++;
+            }
+        et_respond (e);
+        }
+    ethq_remove (&et_rque);
+    }
+}
+
+/* Receive poll */
+
+t_stat et_svc (UNIT *uptr)
+{
+if (et_state () == PST_ENABLED) {
+    if (et_eth) {
+        while (eth_read (et_eth, &et_rbuf, NULL) > 0) {
+            if (sim_deb && (et_dev.dctrl & DBG_PCK))
+                eth_packet_trace_ex (et_eth, et_rbuf.msg, et_rbuf.len, "et-recv", et_dev.dctrl & DBG_DAT, DBG_PCK);
+            if (et_rque.count >= et_rque.max)
+                ethq_remove (&et_rque);         /* oldest goes */
+            ethq_insert (&et_rque, 2, &et_rbuf, 0);
+            }
+        }
+    et_deliver ();
+    et_work_cmdq (0);                           /* retry after interlock */
+    if (uptr->flags & UNIT_ATT)
+        sim_clock_coschedule (uptr, et_poll);
+    }
+return SCPE_OK;
+}
+
+/* Reset (power-up, RESET): the self-test has passed */
+
+t_stat et_reset (DEVICE *dptr)
+{
+static t_bool mac_set = FALSE;
+
+if (!mac_set) {                                 /* first time: a DEC address */
+    eth_mac_scan_ex (et_mac, "08:00:2B:00:00:00/24", &et_unit[0]);
+    mac_set = TRUE;
+    }
+memcpy (et_apa, et_mac, sizeof (ETH_MAC));
+memset (&et_biic, 0, sizeof (et_biic));
+et_biic.csr = (1u << BICSR_V_IF) | BICSR_STS | (et_node () & BICSR_NODE);
+et_pc = 0;
+et_ps = PS_STD | PS_ACC | (PST_UNDEF << PS_V_PST);
+et_pe = et_pd = 0;
+et_vector = 0;
+et_irq = FALSE;
+et_pt.valid = FALSE;
+memset (et_ptdb, 0, sizeof (et_ptdb));
+et_set_filter ();
+if (et_rque.max == 0)
+    ethq_init (&et_rque, ET_RQUE_MAX);
+ethq_clear (&et_rque);
+et_cnt_zero = sim_os_msec ();
+sim_cancel (&et_unit[0]);
+sim_cancel (&et_unit[1]);
+sim_cancel (&et_unit[2]);
+et_update_int ();
+return SCPE_OK;
+}
+
+/* Attach, detach */
+
+t_stat et_attach (UNIT *uptr, CONST char *cptr)
+{
+t_stat r;
+char *tptr;
+
+if (uptr != &et_unit[0])
+    return SCPE_NOATT;
+tptr = (char *) malloc (strlen (cptr) + 1);
+if (tptr == NULL)
+    return SCPE_MEM;
+strcpy (tptr, cptr);
+et_eth = (ETH_DEV *) calloc (1, sizeof (ETH_DEV));
+if (et_eth == NULL) {
+    free (tptr);
+    return SCPE_MEM;
+    }
+r = eth_open (et_eth, cptr, &et_dev, DBG_ETH);
+if (r == SCPE_OK)
+    r = eth_check_address_conflict (et_eth, et_mac);
+if (r != SCPE_OK) {
+    eth_close (et_eth);
+    free (et_eth);
+    et_eth = NULL;
+    free (tptr);
+    return r;
+    }
+eth_setcrc (et_eth, 1);                         /* frames with their CRC */
+uptr->filename = tptr;
+uptr->flags |= UNIT_ATT;
+et_set_filter ();
+if (et_state () == PST_ENABLED)
+    sim_clock_coschedule (uptr, et_poll);
+return SCPE_OK;
+}
+
+t_stat et_detach (UNIT *uptr)
+{
+if (!(uptr->flags & UNIT_ATT))
+    return SCPE_OK;
+sim_cancel (uptr);
+eth_close (et_eth);
+free (et_eth);
+et_eth = NULL;
+free (uptr->filename);
+uptr->filename = NULL;
+uptr->flags &= ~UNIT_ATT;
+return SCPE_OK;
+}
+
+/* SET ET NODE=n */
+
+static t_stat et_set_node (UNIT *uptr, int32 val, CONST char *cptr, void *desc)
+{
+t_stat r;
+int32 node;
+
+if (cptr == NULL)
+    return SCPE_ARG;
+node = (int32) get_uint (cptr, 10, 15, &r);
+if (r != SCPE_OK)
+    return r;
+if (node < 2)                                   /* 0, 1: the KA820s */
+    return sim_messagef (SCPE_ARG, "Node %d is a KA820 node\n", node);
+et_irq = FALSE;
+et_update_int ();
+et_dib.ba = (uint32) node;
+et_biic.csr = (et_biic.csr & ~BICSR_NODE) | (uint32) node;
+return SCPE_OK;
+}
+
+static t_stat et_show_node (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
+{
+fprintf (st, "node=%d", et_node ());
+return SCPE_OK;
+}
+
+/* SET ET MAC=address */
+
+static t_stat et_set_mac (UNIT *uptr, int32 val, CONST char *cptr, void *desc)
+{
+t_stat r;
+
+if (cptr == NULL)
+    return SCPE_ARG;
+if (et_unit[0].flags & UNIT_ATT)
+    return SCPE_ALATT;
+r = eth_mac_scan_ex (et_mac, cptr, &et_unit[0]);
+if (r == SCPE_OK)
+    memcpy (et_apa, et_mac, sizeof (ETH_MAC));
+return r;
+}
+
+static t_stat et_show_mac (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
+{
+char buf[32];
+
+eth_mac_fmt (et_mac, buf);
+fprintf (st, "MAC=%s", buf);
+return SCPE_OK;
+}
+
+/* Help */
+
+const char *et_description (DEVICE *dptr)
+{
+return "DEBNA VAXBI Ethernet adapter";
+}
+
+t_stat et_help_attach (FILE *st, DEVICE *dptr, UNIT *uptr, int32 flag, const char *cptr)
+{
+return eth_attach_help (st, dptr, uptr, flag, cptr);
+}
+
+t_stat et_help (FILE *st, DEVICE *dptr, UNIT *uptr, int32 flag, const char *cptr)
+{
+fprintf (st, "DEBNA VAXBI Ethernet adapter (ET)\n\n");
+fprintf (st, "The DEBNA is a VAXBI node that connects the VAX 8200/8300 to an Ethernet.\n");
+fprintf (st, "VMS V4.7 shows it as \"BI - AIE Adapter with NI port only\" (SYSGEN\n");
+fprintf (st, "SHOW/ADAPTER) and calls it ETA0; its DECnet line and circuit are BNT-0\n");
+fprintf (st, "(named after the DEBNT, the DEBNA's earlier name).  It is disabled by\n");
+fprintf (st, "default:\n\n");
+fprintf (st, "   sim> SET ET ENABLE\n");
+fprintf (st, "   sim> SET ET NODE=7                 (BI node 2-15, default 7)\n");
+fprintf (st, "   sim> SET ET MAC=08:00:2B:12:34:56  (hardware address, before ATTACH)\n");
+fprintf (st, "   sim> ATTACH ET <interface>         (as for XU and XQ, see HELP ET ATTACH)\n\n");
+fprintf (st, "Two simulators can be connected without a host interface, e.g.\n\n");
+fprintf (st, "   sim> ATTACH ET udp:5001:localhost:5002\n\n");
+fprintf (st, "and on the other simulator ATTACH XQ udp:5002:localhost:5001.  DECnet on\n");
+fprintf (st, "VMS V4.7:\n\n");
+fprintf (st, "   $ MC NCP DEFINE LINE BNT-0 STATE ON\n");
+fprintf (st, "   $ MC NCP DEFINE CIRCUIT BNT-0 STATE ON\n");
+fprintf (st, "   $ @SYS$MANAGER:STARTNET\n\n");
+fprintf (st, "The DEBNA implements the BI VAX Port (BVP) Ethernet port: port\n");
+fprintf (st, "registers at node space 204-210, PUDR at 214, the Ethernet address at\n");
+fprintf (st, "218-21D, device type 410F.  After a node reset the self-test takes\n");
+fprintf (st, "0.1 s (BROKE set meanwhile).  An error of the host side transport (e.g.\n");
+fprintf (st, "no UDP partner yet) is not reported as a send failure: frames are lost\n");
+fprintf (st, "as on a cable with nobody listening.  Not simulated: the DEBNK's TK50\n");
+fprintf (st, "port, booting from the network (BOOT ET; a real 8200 uses its console\n");
+fprintf (st, "EEPROM boot program ET, SIMH's built-in VMB has no DEBNA driver).\n\n");
+fprint_set_help (st, dptr);
+fprint_show_help (st, dptr);
+fprint_reg_help (st, dptr);
+return SCPE_OK;
+}
