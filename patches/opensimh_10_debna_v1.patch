+    { FLDATAD (IRQ,      et_irq,          0, "interrupt request") },
+    { HRDATAD (SPT,      et_pt.spte,     32, "system page table, physical") },
+    { HRDATAD (SPTLEN,   et_pt.spts,     32, "system page table length") },
+    { HRDATAD (GPT,      et_pt.gpte,     32, "global page table, virtual") },
+    { HRDATAD (GPTLEN,   et_pt.gpts,     32, "global page table length") },
+    { BRDATAD (CNT,      et_cnt, 10, 32, CNT_NUM, "counters") },
+    { DRDATAD (POLL,     et_poll,        8, "receive poll interval, clock ticks"), REG_NZ },
