+   copy of this software and associated documentation files (the "Software"),
+   to deal in the Software without restriction, including without limitation
+   the rights to use, copy, modify, merge, publish, distribute, sublicense,
+   and/or sell copies of the Software, and to permit persons to whom the
+   Software is furnished to do so, subject to the following conditions:
+
+   The above copyright notice and this permission notice shall be included in
+   all copies or substantial portions of the Software.
+
+   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+   IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+   FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+   THE AUTHORS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER
+   IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+   CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+   et           DEBNA (T1034) - VAXBI Ethernet adapter
+
+   References:
+     EK-DEBNX-IN-001  DEBNA/DEBNK Installation Guide (registers: appendix B,
+                      self-test: chapter 3, boot: appendix C, Ethernet
+                      address: appendix D)
+     NetBSD sys/dev/bi/if_ni.c, if_nireg.h: the BI VAX Port (BVP) data
+                      structures as a host driver uses them (interface facts
+                      only; no code taken)
+     VMS V4.7 ETDRIVER: traced where the above leave a point open
+
+   The DEBNA is a MicroVAX with a LANCE behind a BIIC and a BCI3.  The host
+   talks to its Ethernet ("NI") port through the BVP architecture: four port
+   registers in the BCI3 general purpose registers (PC port control, PS port
+   status, PE port error, PD port data at bb+204..210) and, in host memory,
+   a port queue block (PQB) with command queues and a response queue, a
+   free queue block (FQB) with the free queues (messages, transmit and
+   receive datagrams) and a buffer descriptor table (BDT).  The queues are
+   VAX self-relative interlocked queues (INSQTI/REMQHI); the port reaches
+   the queue entries by system virtual address through the system page
+   table, the buffers through the PTE address in their BDT entry.
+
+   Port instructions (PC bits 6:0, OWN bit 7 set by the host, cleared by the
+   port when it has taken the instruction):
+     INIT       data = physical address of the PQB: state UNDEFINED -> INITIALIZED
+     ENABLE     INITIALIZED -> ENABLED
+     SHUTDOWN   back to UNDEFINED
+     CMDQNE     command queue (bits 9:8) not empty: work it
+     FREEQNE    free queue (bits 9:8) not empty: receives can continue
+   The port reports a state change or a queued response in PS (OWN, RSQ)
+   and interrupts with the vector from the PQB.
+
+   Command queue entries (both 512 bytes in the host drivers):
+     datagram   opcode 1: transmit the frame described by its buffer list
+                (offset, length, BDT index with a chain bit, key); with the
+                R flag (byte 0F bit 0) it comes back on the response queue,
+                else it goes back to its free queue
+     message    opcode 2: NI function in the sub-opcode (write/read system
+                ID, write/read parameters, read (and clear) counters, set and
+                clear a protocol type definition block (PTDB)); comes back
+                as opcode 34 on the response queue
+   A received frame is put into an entry from the free queue its PTDB names
+   (opcode 33, buffer and length in the first buffer list item) and queued
+   on the response queue.
+
+   Found with VMS V4.7 (ETDRIVER, traced and disassembled with SIMH):
+   the vector and level word of the PQB is <15:2> vector, <1:0> level (2 =
+   BR5, VMS vector 15C for node 7); the free queue block gives each queue's
+   entry length (messages 96, datagrams 80 bytes), so the port never writes
+   past it; a PTDB's index is any longword (VMS: an address), received
+   datagrams carry it; WPARAM's second address field is the address to use
+   (DECnet AA-00-04-...), the answer has the hardware address in the first;
+   VMS reads a transmit's completion status from byte 12 of the entry, which
+   it does not clear when it reuses an entry, a received frame's from byte
+   0D; the counters are the 64-byte DEC Ethernet counter block; VMS gives
+   back PS OWN right after it issues an instruction, so the port takes an
+   instruction a little later, as the board's MicroVAX does.
+
+   Modification history:
+
+   16-Nov-26    Ulli/Claude  First version (VAX 8200/8300)
+*/
+
+#include "vax_defs.h"
+#include "vax_bi.h"
+#include "vax_bi_dma.h"
+#include "sim_ether.h"
+
+/* Node, identity */
+
+#define ET_DEF_NODE     7                       /* decision D3 */
+#define ET_DTYPE        0x0200410F              /* T1034, rev 0, DEBNA */
+#define ET_PUDR         0x7FFB0FDF              /* self-test passed, no tape */
+#define ET_IPL_DEF      0x15                    /* until the PQB gives one */
+
+/* Node space offsets */
+
+#define EOF_DTYPE       0x000                   /* BIIC registers */
+#define EOF_BICSR       0x004
+#define EOF_BER         0x008
+#define EOF_EICR        0x00C
+#define EOF_IDEST       0x010
+#define EOF_IMSK        0x014
+#define EOF_FIDEST      0x018
+#define EOF_ISRC        0x01C
+#define EOF_SADR        0x020
+#define EOF_EADR        0x024
+#define EOF_BCICSR      0x028
+#define EOF_UINTRCSR    0x040
+#define EOF_RXCD        0x200                   /* receive console data */
+#define EOF_PC          0x204                   /* NI port registers */
+#define EOF_PS          0x208
+#define EOF_PE          0x20C
+#define EOF_PD          0x210
+#define EOF_PUDR        0x214
+#define EOF_ADDR0       0x218                   /* Ethernet address bytes 0-3 */
+#define EOF_ADDR1       0x21C                   /* bytes 4-5 */
+
+/* Port control register */
+
+#define PC_OWN          0x00000080              /* owned by the port */
+#define PC_INS          0x0000007F              /* instruction */
+#define PC_V_QUE        8                       /* queue select */
+#define PC_M_QUE        3
+#define PCI_INIT        1
+#define PCI_ENABLE      2
+#define PCI_SHUTDOWN    4
+#define PCI_CMDQNE      6
+#define PCI_FREEQNE     7
+#define PCI_RESTART     11
+
+/* Port status register */
+
+#define PS_OWN          0x80000000              /* owned by the host (status posted) */
+#define PS_RPSQ         0x40000000              /* response to a port status query */
+#define PS_STD          0x20000000              /* self-test done */
+#define PS_ACC          0x10000000              /* adapter can communicate */
+#define PS_XSTP         0x08000000              /* extended self-test passed */
+#define PS_ERL          0x04000000              /* error lost */
+#define PS_FQE          0x02000000              /* free queue exhausted */
+#define PS_V_PST        16                      /* port state */
+#define PS_M_PST        7
+#define PS_PST          (PS_M_PST << PS_V_PST)
+#define PS_V_ETYPE      8                       /* error type */
+#define PS_M_ETYPE      0xFF
+#define PS_RSQ          0x00000080              /* response queued */
+#define PS_SUME         0x00000040              /* summary error */
+#define PST_UNDEF       1
+#define PST_INIT        2
+#define PST_ENABLED     4
+#define PST_STOPPED     6
+#define PST_MAINT       7
+#define ETY_PLE         6                       /* port logical error */
+#define PE_ILLINS       0x0B                    /* illegal port instruction */
+#define PE_INSSTATE     0x0C                    /* instruction illegal in state */
+#define PE_PQB          0x08                    /* invalid PQB */
+
+/* Port queue block (offsets from its start) */
+
+#define PQB_CMDQ0       0x00                    /* command queues 0-3 */
+#define PQB_RSPQ        0x20                    /* response queue */
+#define PQB_VECLVL      0x28                    /* word: vector and level */
+#define PQB_NODE        0x2A                    /* word: node(s) to interrupt */
+#define PQB_FREEQ       0x2C                    /* number of free queues */
+#define PQB_VFQB        0x30                    /* virtual address of the FQB */
+#define PQB_BVPLVL      0xD0                    /* BVP level */
+#define PQB_VPQB        0xD4                    /* virtual address of the PQB */
+#define PQB_VBDT        0xD8                    /* virtual address of the BDT */
+#define PQB_NBDT        0xDC                    /* number of BDT entries */
+#define PQB_SPT         0xE0                    /* system page table (physical) */
+#define PQB_SPTLEN      0xE4
+#define PQB_GPT         0xE8                    /* global page table (virtual) */
+#define PQB_GPTLEN      0xEC
+
+/* Free queue block: per queue a quadword (entry length, unused), then the
+   queue header */
+
+#define FQB_SIZE        0x10                    /* bytes per free queue */
+#define FQB_LEN         0x00
+#define FQB_HDR         0x08
+#define FQ_MSG          0
+#define FQ_DG           1
+#define FQ_RCV          2
+#define FQ_MAX          4
+
+/* Queue entries */
+
+#define QE_STATUS       0x0D                    /* byte */
+#define QE_OPCODE       0x0E                    /* byte */
+#define QE_FLAGS        0x0F                    /* byte: bit 0 R (respond) */
+#define QE_LEN          0x10                    /* word: length after the header */
+#define QE_MSG_OPC2     0x12                    /* message: NI function */
+#define QE_MSG_STS2     0x13
+#define QE_MSG_TEXT     0x18
+#define QE_DG_XSTS      0x12                    /* datagram: transmit status (byte; VMS
+                                                   reuses entries without clearing it) */
+#define QE_DG_CMDREF    0x14
+#define QE_DG_PTDBX     0x18
+#define QE_DG_BUFS      0x1C                    /* buffer list, 8 bytes each */
+#define QE_SIZE         512                     /* largest entry we look at */
+#define QEF_R           0x01
+#define DGB_CHAIN       0x8000                  /* more items follow */
+#define DGB_INDEX       0x7FFF
+#define DGB_MAX         32                      /* items per datagram, sanity */
+
+#define OPC_DGRAM       1
+#define OPC_MSG         2
+#define OPC_DGRAMI      3
+#define OPC_DGRAMRX     33
+#define OPC_MSGRX       34
+
+#define NI_WSYSID       1
+#define NI_RSYSID       2
+#define NI_WPARAM       3
+#define NI_RPARAM       4
+#define NI_RCCNTR       5
+#define NI_RDCNTR       6
+#define NI_STPTDB       7
+#define NI_CLPTDB       8
+
+/* Buffer descriptor table entry (16 bytes) */
+
+#define BD_STATUS       0x00                    /* word: offset <8:0>, valid <15> */
+#define BD_KEY          0x02
+#define BD_LEN          0x04
+#define BD_PTE          0x08                    /* system virtual address of the PTE */
+#define BD_SIZE         16
+#define BDS_OFFSET      0x01FF
+#define BDS_VALID       0x8000
+
+/* Parameter block (message text of WPARAM/RPARAM).  The first field is the
+   default (hardware) physical address, which the answer carries (NetBSD
+   reads its address from it); the second is the actual physical address:
+   VMS writes the address it wants there (DECnet AA-00-04-...), zero keeps
+   the current one. */
+
+#define PAR_DPA         0x00                    /* default physical address */
+#define PAR_APA         0x08                    /* actual physical address */
+#define PAR_LSA         0x10                    /* last source address */
+#define PAR_BVC         0x18
+#define PAR_CURADDR     0x20                    /* words */
+#define PAR_MAXADDR     0x22
+#define PAR_CURPTT      0x24
+#define PAR_MAXPTT      0x26
+#define PAR_CURFQ       0x28
+#define PAR_MAXFQ       0x2A
+#define PAR_SID         0x2C                    /* longwords */
+#define PAR_MOP         0x30
+#define PAR_FLAGS       0x34
+#define PAR_RCTO        0x38
+#define PAR_XMTO        0x3C
+#define PAR_SIZE        0x40
+
+/* Protocol type definition block (message text of STPTDB/CLPTDB) */
+
+#define PTD_TYPE        0x00                    /* word */
+#define PTD_FQUE        0x02                    /* byte */
+#define PTD_FLAGS       0x03                    /* byte */
+#define PTD_INDEX       0x04                    /* longword */
+#define PTD_ADRLEN      0x08                    /* word */
+#define PTD_802         0x0A                    /* word */
+#define PTD_MCAST       0x0C                    /* 16 x 8 bytes */
+#define PTDF_PROMISC    0x08
+#define PTDF_802        0x10
+#define PTDF_BDC        0x20                    /* broadcast */
+#define PTDF_UNKN       0x40                    /* types no other PTDB takes */
+#define PTDF_AMC        0x80                    /* all multicast */
+#define ET_MAXPTDB      16
+#define ET_MAXMC        16
+
+typedef struct {
+    t_bool  valid;
+    uint32  index;
+    uint16  type;
+    uint16  sap802;
+    uint8   fque;
+    uint8   flags;
+    int32   nmc;
+    ETH_MAC mc[ET_MAXMC];
+    } ET_PTDB;
+
+/* Debug flags */
+
+#define DBG_REG         0x0001                  /* register access */
+#define DBG_PORT        0x0002                  /* port instructions, states */
+#define DBG_QUE         0x0004                  /* queue entries */
+#define DBG_XMT         0x0008                  /* transmit */
+#define DBG_RCV         0x0010                  /* receive */
+#define DBG_MSG         0x0020                  /* messages */
+#define DBG_INT         0x0040                  /* interrupts */
+#define DBG_PCK         0x0080                  /* packet headers */
+#define DBG_DAT         0x0100                  /* packet data, DMA */
+#define DBG_ETH         0x0200                  /* sim_ether */
+
+#define ET_RQUE_MAX     128                     /* frames waiting for a buffer */
+#define ET_SELFTEST     100000                  /* self-test after node reset, usec */
+#define ET_PCDELAY      50                      /* port takes an instruction, instr. */
+
+extern uint32 nexus_req[NEXUS_HLVL];
+
+/* State */
+
+static BIIC et_biic;                            /* BIIC registers */
+static uint32 et_pc;                            /* port control */
+static uint32 et_ps;                            /* port status */
+static uint32 et_pe;                            /* port error */
+static uint32 et_pd;                            /* port data */
+static uint32 et_pqb_pa;                        /* PQB, physical */
+static uint32 et_pqb_va;                        /* PQB, virtual */
+static uint32 et_fqb_va;                        /* free queue block */
+static uint32 et_nfq;                           /* number of free queues */
+static uint32 et_fq_len[FQ_MAX];                /* their entry lengths */
+static uint32 et_qe_max = QE_SIZE;              /* longest entry */
+static uint32 et_bdt_va;                        /* buffer descriptor table */
+static uint32 et_nbdt;
+static uint32 et_veclvl;                        /* from the PQB */
+static uint32 et_vector;                        /* derived */
+static uint32 et_ipl = ET_IPL_DEF;
+static t_bool et_irq;                           /* interrupt requested */
+static BI_PT et_pt;                             /* page tables */
+static ETH_MAC et_mac;                          /* hardware address */
+static ETH_MAC et_apa;                          /* actual physical address */
+static uint8 et_param[PAR_SIZE];                /* last parameters written */
+static uint8 et_sysid[128];                     /* system ID (WSYSID) */
+static uint32 et_sysid_len;
+static ET_PTDB et_ptdb[ET_MAXPTDB];
+static ETH_DEV *et_eth;                         /* the Ethernet */
+static ETH_QUE et_rque;                         /* frames waiting for a buffer */
+static ETH_PACK et_rbuf;                        /* read buffer */
+static ETH_PACK et_wbuf;                        /* write buffer */
+static int32 et_poll = 1;                       /* clock ticks between polls */
+
+/* Counters: the block of READ COUNTERS (64 bytes; layout found with VMS
+   NCP SHOW LINE COUNTERS, the usual DEC Ethernet counter block):
+     00 W seconds since zeroed    02 L bytes received      06 L bytes sent
+     0A L frames received         0E L frames sent         12 L mc bytes rcvd
+     16 L mc frames received      1A L mc bytes sent       1E L mc frames sent
+     22 L sent, deferred          26 L single collision    2A L multiple coll.
+     2E W send failures           30 W send failure bits   32 W rcv failures
+     34 W rcv failure bits        36 W unrecognized dest.  38 W data overrun
+     3A W system buffer unavail.  3C W user buffer unavail. 3E W collision check */
+
+#define CNT_RBYTES      0                       /* longwords */
+#define CNT_XBYTES      1
+#define CNT_RFRAMES     2
+#define CNT_XFRAMES     3
+#define CNT_RMBYTES     4
+#define CNT_RMFRAMES    5
+#define CNT_XMBYTES     6
+#define CNT_XMFRAMES    7
+#define CNT_NLONG       8
+#define CNT_UNRDEST     8                       /* words */
+#define CNT_SBUF        9
+#define CNT_UBUF        10
+#define CNT_NUM         11
+#define CNT_SIZE        0x40
+static uint32 et_cnt[CNT_NUM];
+static double et_cnt_zero;                      /* when zeroed (sim_os_msec) */
+
+t_stat et_rd (int32 *val, int32 pa, int32 lnt);
+t_stat et_wr (int32 val, int32 pa, int32 lnt);
+int32 et_ack (void);
+t_stat et_reset (DEVICE *dptr);
+t_stat et_svc (UNIT *uptr);
+t_stat et_st_svc (UNIT *uptr);
+t_stat et_pc_svc (UNIT *uptr);
+t_stat et_attach (UNIT *uptr, CONST char *cptr);
+t_stat et_detach (UNIT *uptr);
+t_stat et_help (FILE *st, DEVICE *dptr, UNIT *uptr, int32 flag, const char *cptr);
+t_stat et_help_attach (FILE *st, DEVICE *dptr, UNIT *uptr, int32 flag, const char *cptr);
+const char *et_description (DEVICE *dptr);
+static t_stat et_set_node (UNIT *uptr, int32 val, CONST char *cptr, void *desc);
+static t_stat et_show_node (FILE *st, UNIT *uptr, int32 val, CONST void *desc);
+static t_stat et_set_mac (UNIT *uptr, int32 val, CONST char *cptr, void *desc);
+static t_stat et_show_mac (FILE *st, UNIT *uptr, int32 val, CONST void *desc);
+static void et_port_instr (void);
+static void et_work_cmdq (int32 q);
+static void et_deliver (void);
+static void et_set_filter (void);
+static ET_PTDB *et_find_ptdb (uint32 index, t_bool alloc);
+
+/* Data structures
+
+   et_dev       ET device descriptor
+   et_unit      ET units: 0 = Ethernet (attach, receive poll), 1 = self-test,
+                2 = port instruction
+   et_reg       ET register list
+*/
+
+DIB et_dib = { ET_DEF_NODE, 0, &et_rd, &et_wr, 0, 0, 0, { &et_ack } };
+
+UNIT et_unit[] = {
+    { UDATA (&et_svc, UNIT_IDLE|UNIT_ATTABLE, 0) },
+    { UDATA (&et_st_svc, UNIT_DIS, 0) },
+    { UDATA (&et_pc_svc, UNIT_DIS, 0) },
+    };
+
+REG et_reg[] = {
+    { HRDATAD (PC,       et_pc,          32, "port control") },
+    { HRDATAD (PS,       et_ps,          32, "port status") },
+    { HRDATAD (PE,       et_pe,          32, "port error") },
+    { HRDATAD (PD,       et_pd,          32, "port data") },
+    { HRDATAD (PQB,      et_pqb_pa,      32, "port queue block, physical") },
+    { HRDATAD (VPQB,     et_pqb_va,      32, "port queue block, virtual") },
+    { HRDATAD (VFQB,     et_fqb_va,      32, "free queue block, virtual") },
+    { HRDATAD (VBDT,     et_bdt_va,      32, "buffer descriptor table, virtual") },
+    { DRDATAD (NBDT,     et_nbdt,        16, "buffer descriptors") },
