+/* Sound realism mode: the RA60 and the RC25 (see the description at
+   rq_spinup_ms) */
+
+/* Unit index within its controller */
+
+static int32 rq_unit_index (UNIT *uptr)
+{
+return (int32) (uptr - rq_devmap[uptr->cnum]->units);
+}
+
+/* The RC25 that an RCF25 belongs to: the unit just before it, if that is
+   an RC25 and the RCF25 has an odd unit index.  NULL for anything else. */
+
+static UNIT *rq_rc25_of (UNIT *uptr)
+{
+int32 u;
+
+if (GET_DTYPE (uptr->flags) != RCF25_DTYPE)
+    return NULL;
+u = rq_unit_index (uptr);
+if (((u & 1) == 0) || (u >= RQ_MAXDR))
+    return NULL;
+if (GET_DTYPE (rq_devmap[uptr->cnum]->units[u - 1].flags) != RC25_DTYPE)
+    return NULL;
+return &rq_devmap[uptr->cnum]->units[u - 1];
+}
+
+/* The RCF25 that belongs to an RC25 (the unit just after it), NULL if none */
+
+static UNIT *rq_rcf25_of (UNIT *uptr)
+{
+int32 u;
+UNIT *fptr;
+
+if (GET_DTYPE (uptr->flags) != RC25_DTYPE)
+    return NULL;
+u = rq_unit_index (uptr);
+if (((u & 1) != 0) || ((u + 1) >= RQ_MAXDR))
+    return NULL;
+fptr = &rq_devmap[uptr->cnum]->units[u + 1];
+return (rq_rc25_of (fptr) == uptr) ? fptr : NULL;
+}
+
+/* The unit that owns the spindle (RUN/STOP button) a unit turns on: the
+   unit itself for an RA60 and an RC25, the RC25 for an RCF25 that belongs
+   to one; NULL for a unit without a button (fixed disks, a lone RCF25). */
+
+static UNIT *rq_spindle_owner (UNIT *uptr)
+{
+switch (GET_DTYPE (uptr->flags)) {
+    case RA60_DTYPE:
+    case RC25_DTYPE:
+        return uptr;
+    case RCF25_DTYPE:
+        return rq_rc25_of (uptr);
+    default:
+        return NULL;
+    }
+}
+
+/* The realistic timing of a unit's drive type, NULL if none.  An RCF25
+   uses the RC25 entry, whether it belongs to an RC25 or not. */
+
+static RQ_RLZ_TYPE *rq_rlz_type (UNIT *uptr)
+{
+uint32 dt = GET_DTYPE (uptr->flags);
+size_t i;
+
+if (dt == RCF25_DTYPE)
+    dt = RC25_DTYPE;
+for (i = 0; i < sizeof (rq_rlz_types) / sizeof (rq_rlz_types[0]); i++)
+    if (rq_rlz_types[i].dtype == dt)
+        return &rq_rlz_types[i];
+return NULL;
+}
+
+/* The spindle is up to speed: every attached unit on it is available again,
+   so the controller sends an "available" attention message (rq_tmrsvc). */
+
+static void rq_on_ready_unit (UNIT *uptr)
+{
+MSC *cp = rq_ctxmap[uptr->cnum];
+
+if ((uptr->flags & UNIT_ATT) && (cp->csta == CST_UP) && sim_disk_isavailable (uptr))
+    uptr->flags = uptr->flags | UNIT_ATP;
+}
+
+static void rq_on_ready (UNIT *uptr)
+{
+UNIT *fptr = rq_rcf25_of (uptr);
+
+sim_debug (DBG_TRC, rq_devmap[uptr->cnum], "%s: %s up to speed\n", sim_uname (uptr),
+           drv_tab[GET_DTYPE (uptr->flags)].name);
+rq_on_ready_unit (uptr);
+if (fptr != NULL)                                       /* RC25: the fixed platter too */
+    rq_on_ready_unit (fptr);
+}
+
+/* The unit's realism state, allocated on first use; NULL only if out of
+   memory or the unit is not part of a controller. */
+
+static RQ_RLZ *rq_rlz_get (UNIT *uptr)
+{
+uint32 c = uptr->cnum;
+int32 u = rq_unit_index (uptr);
+RQ_RLZ *rz;
+
+if ((c >= RQ_NUMCT) || (u < 0) || (u >= (RQ_MAXDR + 2)))
+    return NULL;
+rz = rq_rlz[c][u];
+if (rz == NULL) {
+    rz = (RQ_RLZ *) calloc (1, sizeof (*rz));
+    if (rz == NULL)
+        return NULL;
+    rq_rlz[c][u] = rz;
+    }
+return rz;
+}
+
+/* The realism state that holds the spindle of a unit's drive, with the
+   spindle set up for the drive type (on first use, and again when the
+   owner's type was changed meanwhile).  NULL for a unit without a button. */
+
+static RQ_RLZ *rq_rlz_spindle (UNIT *uptr)
+{
+UNIT *optr = rq_spindle_owner (uptr);
+RQ_RLZ_TYPE *ty;
+RQ_RLZ *rz;
+
+if ((optr == NULL) || ((ty = rq_rlz_type (optr)) == NULL) ||
+    ((rz = rq_rlz_get (optr)) == NULL))
+    return NULL;
+if (rz->sp.uptr == NULL)                                /* first use */
+    sim_spindle_init (&rz->sp, optr, ty->spinup_ms, ty->spindown_ms,
+                      &rq_on_ready, NULL, SND_GRP_DISK, RQ_SPIN_GAIN);
+if (rz->sp.uptr == NULL)                                /* no spindle slot left */
+    return NULL;
+if (rz->sp_type != ty) {                                /* (new) type: its times */
+    sim_spindle_off (&rz->sp);
+    rz->sp.spinup_ms = ty->spinup_ms;
+    rz->sp.spindown_ms = ty->spindown_ms;
+    rz->sp_type = ty;
+    }
+return rz;
+}
+
+/* The spindle a unit turns on, if it was ever set up (no allocation) */
+
+static SND_SPINDLE *rq_spindle_peek (UNIT *uptr)
+{
+UNIT *optr = rq_spindle_owner (uptr);
+RQ_RLZ *rz;
+
+if ((optr == NULL) || (optr->cnum >= RQ_NUMCT) ||
+    ((rz = rq_rlz[optr->cnum][rq_unit_index (optr)]) == NULL) ||
+    (rz->sp.uptr == NULL) || (rz->sp_type != rq_rlz_type (optr)))
+    return NULL;
+return &rz->sp;
+}
+
+/* Is the unit ready: attached and its spindle up to speed?  A unit whose
+   spindle was never set up (never attached since the start) counts as
+   ready if attached, as do units without a button.  An RCF25 needs the
+   cartridge of its RC25 in the realism mode; in the normal mode an RCF25
+   whose RC25 has no cartridge works as before. */
+
+static t_bool rq_ready (UNIT *uptr)
+{
+UNIT *optr;
+SND_SPINDLE *sp;
+
+if (!(uptr->flags & UNIT_ATT))
+    return FALSE;
+if ((optr = rq_spindle_owner (uptr)) == NULL)
+    return TRUE;
+if (optr != uptr) {                                     /* RCF25 of an RC25 */
+    if (!(optr->flags & UNIT_ATT))                      /* no cartridge: */
+        return !sim_sound_enabled ();                   /* platters stopped (realism) */
+    }
+if ((sp = rq_spindle_peek (uptr)) == NULL)
+    return (optr == uptr) || !sim_sound_enabled ();
+return (sim_spindle_state (sp) == SND_SPIN_READY);
+}
+
+/* A unit loses its online state because its spindle stops or its
+   cartridge is gone; a transfer in progress ends with "offline, no
+   volume" when it is serviced next (rq_svc). */
+
+static void rq_unit_stopped (UNIT *uptr)
+{
+uptr->flags = uptr->flags & ~(UNIT_ONL | UNIT_ATP);
+uptr->uf = 0;
+}
+
+/* Spin a drive down (RUN/STOP button, or AVAILABLE with spin-down in the
+   realism mode).  Every unit on the spindle leaves the online state.  The
+   pack or cartridge stays attached. */
+
+static void rq_spin_down (UNIT *uptr)
+{
+RQ_RLZ *rz = rq_rlz_spindle (uptr);
+UNIT *optr = rq_spindle_owner (uptr);
+UNIT *fptr;
+int32 st;
+
+if ((rz == NULL) || (optr == NULL))
+    return;
+st = sim_spindle_state (&rz->sp);
+if ((st == SND_SPIN_STOPPED) || (st == SND_SPIN_DOWN))
+    return;
+sim_debug (DBG_TRC, rq_devmap[optr->cnum], "%s: %s spin down\n", sim_uname (optr),
+           drv_tab[GET_DTYPE (optr->flags)].name);
+rq_unit_stopped (optr);
+if ((fptr = rq_rcf25_of (optr)) != NULL)                /* RC25: the fixed platter too */
+    rq_unit_stopped (fptr);
+sim_spindle_stop (&rz->sp);
+}
+
+/* AVAILABLE with the spin-down modifier in the realism mode: does it spin
+   the drive down?  Always for a unit with a RUN/STOP button: on an RC25
+   drive this stops both platters, and the other unit goes offline too,
+   as on the real drive (decided 2026-11-07; up to sound patch v12 only if
+   the other unit was not online). */
+
+static t_bool rq_avl_spins_down (UNIT *uptr)
+{
+return (rq_spindle_owner (uptr) != NULL);
+}
+
+/* SET RQn ONLINE / OFFLINE: the RUN/STOP button of the RA60, the Run
+   button of the RC25 (on either unit of the drive).  Realism mode at the
+   sim> prompt: wait until ready or at rest unless SET -N. */
+
+t_stat rq_set_online (UNIT *uptr, int32 val, CONST char *cptr, void *desc)
+{
+UNIT *optr = rq_spindle_owner (uptr);
+RQ_RLZ *rz;
+
+if (cptr != NULL)
+    return SCPE_ARG;
+if (optr == NULL) {
+    if (GET_DTYPE (uptr->flags) == RCF25_DTYPE)
+        return sim_messagef (SCPE_NOFNC, "%s: this RCF25 belongs to no RC25 (the RC25 must be the unit before it, at an even unit)\n",
+                             sim_uname (uptr));
+    return sim_messagef (SCPE_NOFNC, "%s: the %s has no RUN/STOP button (only the RA60 and the RC25)\n",
+                         sim_uname (uptr), drv_tab[GET_DTYPE (uptr->flags)].name);
+    }
+if (!(optr->flags & UNIT_ATT)) {
+    if (optr != uptr)
+        return sim_messagef (SCPE_UNATT, "%s: no cartridge in %s: the RC25 does not start without one\n",
+                             sim_uname (uptr), sim_uname (optr));
+    return sim_messagef (SCPE_UNATT, "%s: no %s loaded (not attached)\n", sim_uname (uptr),
+                         (GET_DTYPE (uptr->flags) == RC25_DTYPE) ? "cartridge" : "pack");
+    }
+if ((rz = rq_rlz_spindle (uptr)) == NULL)
+    return SCPE_MEM;
+if (val) {
+    sim_debug (DBG_TRC, rq_devmap[optr->cnum], "%s: %s spin up\n", sim_uname (optr),
+               drv_tab[GET_DTYPE (optr->flags)].name);
+    sim_spindle_start (&rz->sp);
+    }
+else
+    rq_spin_down (uptr);
+if (!(sim_switches & SWMASK ('N')))
+    sim_spindle_wait (&rz->sp);                         /* (realism mode, prompt) */
+return SCPE_OK;
+}
+
+/* SHOW RQn SPINDLE.  MTAB_NMO: SCP adds no line end, so this does. */
+
+t_stat rq_show_spindle (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
+{
+UNIT *optr = rq_spindle_owner (uptr);
+t_stat r = SCPE_OK;
+
+if (optr == NULL)
+    fprintf (st, "fixed disk (no RUN/STOP button)");
+else if (!(optr->flags & UNIT_ATT)) {
+    if (optr != uptr)                                   /* (normal mode: usable) */
+        fprintf (st, sim_sound_enabled () ? "no cartridge in %s, stopped" :
+                     "no cartridge in %s (fixed disk usable: realism mode off)", sim_uname (optr));
+    else
+        fprintf (st, "no %s", (GET_DTYPE (uptr->flags) == RC25_DTYPE) ? "cartridge" : "pack");
+    }
+else if (rq_rlz_spindle (uptr) == NULL)
+    r = SCPE_MEM;
+else {
+    if (optr != uptr)
+        fprintf (st, "spindle of %s: ", sim_uname (optr));
+    r = sim_spindle_show (st, &rq_rlz_spindle (uptr)->sp);
+    }
+fputc ('\n', st);
+return r;
+}
+
+/* ATTACH in the realism mode or the normal mode (rq_attach): set up the
+   spindle and the actuator.  Returns TRUE if the unit is ready (then the
+   controller reports it available). */
+
+static t_bool rq_rlz_attach (UNIT *uptr)
+{
+RQ_RLZ_TYPE *ty = rq_rlz_type (uptr);
+UNIT *optr = rq_spindle_owner (uptr);
+RQ_RLZ *rz;
+
+if (ty == NULL)                                         /* no realistic timing */
+    return TRUE;
+if (sim_sound_enabled ())
+    sim_sound_seek_load (ty->smp, ty->snd, ty->snd);
+if ((rz = rq_rlz_get (uptr)) != NULL)                   /* a lone RCF25: own actuator */
+    rz->cyl = 0;
+if (optr == NULL)                                       /* lone RCF25: no button */
+    return TRUE;
+if (optr != uptr)                                       /* RCF25 of an RC25: */
+    return rq_ready (uptr);                             /* as the spindle is */
+if ((rz = rq_rlz_spindle (uptr)) == NULL)
+    return TRUE;
+rz->cyl = 0;                                            /* heads at home */
+if (sim_sound_enabled ()) {                             /* realism: pack loaded, */
+    sim_spindle_load (&rz->sp, ty->snd, ty->snd);
+    sim_spindle_off (&rz->sp);                          /* waits for SET RQn ONLINE */
+    return FALSE;
+    }
+sim_spindle_ready (&rz->sp);                            /* normal: spins up at once */
+return TRUE;
+}
+
+/* DETACH: the pack or cartridge is gone.  The spindle stops at once; on
+   an RC25 drive the fixed platter stops too (realism mode). */
+
+static void rq_rlz_detach (UNIT *uptr)
+{
+SND_SPINDLE *sp;
+UNIT *fptr;
+
+if (rq_spindle_owner (uptr) != uptr)                    /* no button or an RCF25 */
+    return;
+if ((sp = rq_spindle_peek (uptr)) != NULL)
+    sim_spindle_off (sp);
+if (sim_sound_enabled () && ((fptr = rq_rcf25_of (uptr)) != NULL))
+    rq_unit_stopped (fptr);
+}
+
+/* Seek curve t(d) = a + b * d^e (us): the exponent is fitted (bisection)
+   so that the curve goes through the track-to-track, the average (at a
+   third of the stroke) and the maximum seek time. */
+
+static double rq_seek_us (RQ_RLZ_TYPE *ty, int32 dist)
+{
+if (!ty->fitted) {
+    double d = (double) (ty->cyl - 1);
+    double want = (ty->avg_ms - ty->t2t_ms) / (ty->max_ms - ty->t2t_ms);
+    double lo = 0.2, hi = 1.5, e = 0.69;
+    int32 i;
+
+    for (i = 0; i < 60; i++) {                          /* ratio falls with e */
+        e = (lo + hi) / 2.0;
+        if (((pow (d / 3.0, e) - 1.0) / (pow (d, e) - 1.0)) > want)
+            lo = e;
+        else
+            hi = e;
+        }
+    ty->cb = (ty->max_ms - ty->t2t_ms) / (pow (d, e) - 1.0);
+    ty->ca = ty->t2t_ms - ty->cb;
+    ty->ea = e;
+    ty->fitted = TRUE;
+    }
+if (dist <= 0)
+    return 0.0;
+return (ty->ca + ty->cb * pow ((double) dist, ty->ea)) * 1000.0;
+}
+
+/* Realistic time of a transfer command (us): seek from the current
+   cylinder of the drive's actuator (with its sound), rotational latency,
+   one sector slot per block and the time to go on to each next track.
+   Updates the current cylinder.  The units of an RC25 drive share the
+   actuator; both platters have the same geometry. */
+
+static double rq_rlz_xfer_us (UNIT *uptr, uint32 lbn, uint32 bc)
+{
+RQ_RLZ_TYPE *ty = rq_rlz_type (uptr);
+UNIT *optr = rq_spindle_owner (uptr);
+RQ_RLZ *rz = rq_rlz_get ((optr != NULL) ? optr : uptr);
+uint32 nblk = (bc + RQ_NUMBY - 1) / RQ_NUMBY;
+uint32 lpc, t0, t1;
+double rev_us;
+int32 c0, c1, from, dist, cls;
+double us;
+
+if ((rz == NULL) || (ty == NULL))
+    return 0.0;
+lpc = ty->sect * ty->surf;                              /* blocks per cylinder */
+rev_us = 60000000.0 / ty->rpm;
+if (nblk == 0)
+    nblk = 1;
+c0 = (int32) (lbn / lpc);                               /* first and last cylinder */
+c1 = (int32) ((lbn + nblk - 1) / lpc);
+from = rz->cyl;
+dist = abs (c0 - from);
+us = rq_seek_us (ty, dist);
+cls = sim_sound_seek (ty->smp, dist, *ty->seek_s, *ty->seek_m, FALSE, SND_GRP_DISK, RQ_SEEK_GAIN);
+if (cls >= 0)
+    sim_debug (DBG_TRC, rq_devmap[uptr->cnum], "%s: %s seek sound %s (%d cylinders)\n",
+               sim_uname (uptr), ty->name, (cls == 0) ? "short" : ((cls == 1) ? "medium" : "long"), dist);
+rq_rand_state = rq_rand_state * 1103515245u + 12345u;   /* latency 0 .. one rev */
+us += fmod ((double) (rq_rand_state >> 8), rev_us);
+us += (double) nblk * rev_us / ty->slots;               /* sector slots */
+if (ty->next_trk_ms > 0.0) {                            /* per track crossed */
+    t0 = lbn / ty->sect;
+    t1 = (lbn + nblk - 1) / ty->sect;
+    us += (double) (t1 - t0) * ty->next_trk_ms * 1000.0;
+    }
+else                                                    /* per cylinder crossed */
+    us += (double) (c1 - c0) * ty->t2t_ms * 1000.0;
+rz->cyl = c1;
+if (us < 100.0)
+    us = 100.0;
+sim_debug (DBG_TRC, rq_devmap[uptr->cnum], "%s: %s LBN %u, %u blocks: from cylinder %d, cylinders %d-%d, %.0f us\n",
+           sim_uname (uptr), ty->name, lbn, nblk, from, c0, c1, us);
+return us;
+}
+
+/* Sound realism mode: configuration rules ("as realistic as possible")
+
+   With SET SOUND ENABLED the RQ controllers must look like real ones:
+   - RC25 drives only on a KLESI controller (the RC25's bus adapter), and a
+     KLESI only connects RC25 drives: a master and at most one slave, i.e.
+     at most 4 enabled units, all RC25 or RCF25;
+   - an RC25 drive is always a pair: the RC25 (cartridge) at an even unit,
+     its RCF25 (fixed platter) at the next unit;
+   - the unit select plug of the drive numbers the pair: the RC25 has an
+     even unit number (PLUG, SET RQn UNIT=), the RCF25 that number + 1.
+   SET SOUND ENABLED refuses a configuration that breaks a rule
+   (rq_rlz_enable_check, registered with sim_sound).  While sound is
+   enabled, SET RQ <controller type>, SET RQn <drive type>, SET RQn UNIT=,
+   SET RQ DRIVES= and ATTACH keep to the rules:
+   - SET RQ KLESI sets units 0/1 and 2/3 to RC25/RCF25 (unit numbers as
+     pairs) and disables the units from 4 on;
+   - SET RQ <other type> on a KLESI sets the RC25/RCF25 units back to the
+     unit's initial drive type;
+   - SET RQn RC25 also sets the next unit to RCF25 (SET RQn RCF25: the unit
+     before it to RC25), SET RQn UNIT=m also renumbers the other unit of
+     the pair;
+   - anything else that breaks a rule is refused, with the unit's settings
+     unchanged.
+   Without the realism mode none of this applies (quick setups as before). */
+
+static t_bool rq_unit_enabled (UNIT *uptr)
+{
+return ((uptr->flags & UNIT_DIS) == 0);
+}
+
+static t_bool rq_is_rc25_type (uint32 dt)
+{
+return ((dt == RC25_DTYPE) || (dt == RCF25_DTYPE));
+}
+
+/* Check the rules for one controller.  Returns SCPE_OK, or prints the
+   first rule broken (with the prefix) and returns SCPE_ARG. */
+
+static t_stat rq_rlz_rules (DEVICE *dptr, const char *prefix)
+{
+MSC *cp = rq_ctxmap[dptr->units[0].cnum];
+t_bool klesi = (cp->ctype == KLESI_CTYPE);
+int32 n = (int32) dptr->numunits - 2;
+int32 u, n_en = 0;
+
+if (dptr->flags & DEV_DIS)
+    return SCPE_OK;
+for (u = 0; u < n; u++) {
+    UNIT *uptr = &dptr->units[u];
+    uint32 dt = GET_DTYPE (uptr->flags);
+
+    if (!rq_unit_enabled (uptr))
+        continue;
+    n_en = n_en + 1;
+    if (klesi && !rq_is_rc25_type (dt))
+        return sim_messagef (SCPE_ARG, "%s%s: a KLESI only connects RC25 drives, %s is an %s\n",
+                             prefix, dptr->name, sim_uname (uptr), drv_tab[dt].name);
+    if (!klesi && rq_is_rc25_type (dt))
+        return sim_messagef (SCPE_ARG, "%s%s: an %s needs a KLESI controller (SET %s KLESI)\n",
+                             prefix, sim_uname (uptr), drv_tab[dt].name, dptr->name);
+    }
+for (u = 0; u < n; u++) {                               /* (types first, then the pairs) */
+    UNIT *uptr = &dptr->units[u];
+    uint32 dt = GET_DTYPE (uptr->flags);
+    UNIT *pptr;
+
+    if (!rq_unit_enabled (uptr))
+        continue;
+    if (dt == RC25_DTYPE) {
+        if (u & 1)
+            return sim_messagef (SCPE_ARG, "%s%s: the RC25 (cartridge) must be at an even unit\n",
+                                 prefix, sim_uname (uptr));
+        pptr = ((u + 1) < n) ? &dptr->units[u + 1] : NULL;
+        if ((pptr == NULL) || !rq_unit_enabled (pptr) || (GET_DTYPE (pptr->flags) != RCF25_DTYPE))
+            return sim_messagef (SCPE_ARG, "%s%s: an RC25 drive is a pair: the RCF25 (fixed platter) must follow at %s%d\n",
+                                 prefix, sim_uname (uptr), dptr->name, u + 1);
+        if ((uptr->unit_plug & 1) || (pptr->unit_plug != (uptr->unit_plug + 1)))
+            return sim_messagef (SCPE_ARG, "%s%s/%s: an RC25 drive has an even/odd pair of unit numbers (UNIT=%d/%d)\n",
+                                 prefix, sim_uname (uptr), sim_uname (pptr), uptr->unit_plug, pptr->unit_plug);
+        }
+    if (dt == RCF25_DTYPE) {
+        pptr = (u > 0) ? &dptr->units[u - 1] : NULL;
+        if (((u & 1) == 0) || (pptr == NULL) || !rq_unit_enabled (pptr) ||
+            (GET_DTYPE (pptr->flags) != RC25_DTYPE))
+            return sim_messagef (SCPE_ARG, "%s%s: an RC25 drive is a pair: the RCF25 (fixed platter) must follow its RC25 (cartridge) at an even unit\n",
+                                 prefix, sim_uname (uptr));
+        }
+    }
+if (klesi && (n_en > KLESI_MAX_UNITS))
+    return sim_messagef (SCPE_ARG, "%s%s: a KLESI connects at most two RC25 drives (%d units), %d units are enabled\n",
+                         prefix, dptr->name, KLESI_MAX_UNITS, n_en);
+return SCPE_OK;
+}
+
+/* SET SOUND ENABLED: every RQ controller must keep to the rules */
+
+static t_stat rq_rlz_enable_check (void)
+{
+int32 i;
+t_stat r;
+
+for (i = 0; i < RQ_NUMCT; i++)
+    if ((r = rq_rlz_rules (rq_devmap[i], "SET SOUND ENABLED: ")) != SCPE_OK)
+        return r;
+return SCPE_OK;
+}
+
+/* A snapshot of a controller's unit settings (flags, capacity, unit
+   number), so that a SET that would break a rule can be undone */
+
+typedef struct rq_usnap {
+    uint32      flags;
+    t_addr      capac;
+    uint32      plug;
+    } RQ_USNAP;
+
+static RQ_USNAP *rq_snap_take (DEVICE *dptr)
+{
+int32 n = (int32) dptr->numunits - 2;
+RQ_USNAP *s = (RQ_USNAP *) calloc ((size_t) n, sizeof (*s));
+int32 u;
+
+if (s != NULL)
+    for (u = 0; u < n; u++) {
+        s[u].flags = dptr->units[u].flags;
+        s[u].capac = dptr->units[u].capac;
+        s[u].plug = dptr->units[u].unit_plug;
+        }
+return s;
+}
+
+static void rq_snap_restore (DEVICE *dptr, RQ_USNAP *s)
+{
+int32 n = (int32) dptr->numunits - 2;
+int32 u;
+
+for (u = 0; u < n; u++) {
+    dptr->units[u].flags = s[u].flags;
+    dptr->units[u].capac = s[u].capac;
+    dptr->units[u].unit_plug = s[u].plug;
+    }
+}
+
+/* After a change made with a snapshot: keep it if the rules hold, else
+   undo it.  Frees the snapshot. */
+
+static t_stat rq_snap_check (DEVICE *dptr, RQ_USNAP *s)
+{
+t_stat r = rq_rlz_rules (dptr, "");
+
+if (r != SCPE_OK)
+    rq_snap_restore (dptr, s);
+free (s);
+return r;
+}
+
+/* Set a unit's drive type (not attached) */
+
+static void rq_put_dtype (UNIT *uptr, uint32 dt)
+{
+uptr->flags = (uptr->flags & ~UNIT_DTYPE) | (dt << UNIT_V_DTYPE);
+uptr->capac = (t_addr) drv_tab[dt].lbn;
+}
+
+/* Is a unit number free on the controller (apart from the units given)? */
+
+static t_bool rq_plug_free (DEVICE *dptr, uint32 plug, UNIT *a, UNIT *b)
+{
+int32 n = (int32) dptr->numunits - 2;
+int32 u;
+
+for (u = 0; u < n; u++)
+    if ((&dptr->units[u] != a) && (&dptr->units[u] != b) &&
+        (dptr->units[u].unit_plug == plug))
+        return FALSE;
+return TRUE;
+}
+
+/* Give a pair the unit numbers p (even) and p + 1, if they are free */
+
+static t_stat rq_pair_plugs (DEVICE *dptr, UNIT *rptr, UNIT *fptr, uint32 p)
+{
+if ((p & 1) || (p >= 65534) || !rq_plug_free (dptr, p, rptr, fptr) || !rq_plug_free (dptr, p + 1, rptr, fptr))
+    return sim_messagef (SCPE_ARG, "%s/%s: unit numbers %u/%u for the RC25 drive are not free\n",
+                         sim_uname (rptr), sim_uname (fptr), p, p + 1);
+rptr->unit_plug = p;
+fptr->unit_plug = p + 1;
+return SCPE_OK;
+}
+
+/* SET RQn <drive type> in the realism mode: an RC25 or RCF25 brings its
+   other half along (unless that unit is attached).  Called by
+   rq_set_type after the type of uptr was set; s is the snapshot from
+   before. */
+
+static t_stat rq_rlz_set_type (UNIT *uptr, RQ_USNAP *s)
+{
+DEVICE *dptr = rq_devmap[uptr->cnum];
+int32 u = rq_unit_index (uptr);
+int32 n = (int32) dptr->numunits - 2;
+uint32 dt = GET_DTYPE (uptr->flags);
+UNIT *rptr = NULL, *fptr = NULL;
+t_stat r;
+
+if ((dt == RC25_DTYPE) && ((u & 1) == 0) && ((u + 1) < n)) {
+    rptr = uptr;
+    fptr = &dptr->units[u + 1];
+    }
+else if ((dt == RCF25_DTYPE) && (u & 1)) {
+    rptr = &dptr->units[u - 1];
+    fptr = uptr;
+    }
+if (rptr != NULL) {
+    UNIT *other = (rptr == uptr) ? fptr : rptr;
+    uint32 odt = (other == fptr) ? RCF25_DTYPE : RC25_DTYPE;
+
+    if (GET_DTYPE (other->flags) != odt) {
+        if (other->flags & UNIT_ATT) {
+            rq_snap_restore (dptr, s);
+            free (s);
+            return sim_messagef (SCPE_ALATT, "%s: the other half of the RC25 drive, %s, is attached as an %s\n",
+                                 sim_uname (uptr), sim_uname (other), drv_tab[GET_DTYPE (other->flags)].name);
+            }
+        rq_put_dtype (other, odt);
+        }
+    other->flags = other->flags & ~UNIT_DIS;
+    if (((rptr->unit_plug & 1) || (fptr->unit_plug != rptr->unit_plug + 1)) &&
+        ((r = rq_pair_plugs (dptr, rptr, fptr, rptr->unit_plug & ~1)) != SCPE_OK) &&
+        ((r = rq_pair_plugs (dptr, rptr, fptr, (uint32) u & ~1)) != SCPE_OK)) {
+        rq_snap_restore (dptr, s);
+        free (s);
+        return r;
+        }
+    }
+return rq_snap_check (dptr, s);
+}
+
+/* SET RQ <controller type> in the realism mode (rq_set_ctype, before the
+   type is changed): to a KLESI, units 0-3 become two RC25 drives and the
+   units from 4 on are disabled; from a KLESI to another type, the RC25
+   and RCF25 units get their initial drive types back.  Refused while a
+   unit that would change is attached. */
+
+static t_stat rq_rlz_set_ctype (UNIT *uptr, int32 newtype)
+{
+MSC *cp = rq_ctxmap[uptr->cnum];
+DEVICE *dptr = rq_devmap[uptr->cnum];
+int32 n = (int32) dptr->numunits - 2;
+int32 u, oldtype = cp->ctype;
+RQ_USNAP *s;
+t_stat r;
+
+if (newtype == cp->ctype)
+    return SCPE_OK;
+for (u = 0; u < n; u++) {                               /* nothing attached that changes */
+    UNIT *xptr = &dptr->units[u];
+    t_bool changes = (newtype == KLESI_CTYPE) ?
+        ((u >= KLESI_MAX_UNITS) || !rq_is_rc25_type (GET_DTYPE (xptr->flags))) :
+        rq_is_rc25_type (GET_DTYPE (xptr->flags));
+
+    if ((xptr->flags & UNIT_ATT) && changes)
+        return sim_messagef (SCPE_ALATT, "%s: %s is attached and would have to change\n",
+                             dptr->name, sim_uname (xptr));
+    }
+if ((s = rq_snap_take (dptr)) == NULL)
+    return SCPE_MEM;
+if (newtype == KLESI_CTYPE) {
+    for (u = 0; u < n; u++) {
+        UNIT *xptr = &dptr->units[u];
+
+        if (u >= KLESI_MAX_UNITS) {
+            if (xptr->flags & UNIT_DISABLE)
+                xptr->flags = xptr->flags | UNIT_DIS;
+            continue;
+            }
+        xptr->flags = xptr->flags & ~UNIT_DIS;
+        if (!(xptr->flags & UNIT_ATT))
+            rq_put_dtype (xptr, (u & 1) ? RCF25_DTYPE : RC25_DTYPE);
+        }
+    for (u = 0; u + 1 < KLESI_MAX_UNITS; u += 2) {
+        UNIT *rptr = &dptr->units[u], *fptr = &dptr->units[u + 1];
+
+        if (((rptr->unit_plug & 1) == 0) && (fptr->unit_plug == rptr->unit_plug + 1))
+            continue;                                   /* already a pair */
+        if (((r = rq_pair_plugs (dptr, rptr, fptr, rptr->unit_plug & ~1)) != SCPE_OK) &&
+            ((r = rq_pair_plugs (dptr, rptr, fptr, (uint32) u)) != SCPE_OK)) {
+            rq_snap_restore (dptr, s);
+            free (s);
+            return r;
+            }
+        }
+    }
+else
+    for (u = 0; u < n; u++) {
+        UNIT *xptr = &dptr->units[u];
+
+        if (rq_is_rc25_type (GET_DTYPE (xptr->flags)))
+            rq_put_dtype (xptr, (u < RQ_NUMDR) ? rq_dflt_dtype[uptr->cnum][u] : rq_dflt_dtype[uptr->cnum][0]);
+        }
+cp->ctype = newtype;
+r = rq_rlz_rules (dptr, "");
+if (r != SCPE_OK) {
+    rq_snap_restore (dptr, s);
+    cp->ctype = oldtype;
+    }
+free (s);
+return r;
+}
+
+/* SET RQn UNIT=m in the realism mode (rq_set_plug, uniqueness already
+   checked): the other half of an RC25 drive gets m + 1 or m - 1 */
+
+static t_stat rq_rlz_set_plug (UNIT *uptr, uint32 plug)
+{
+DEVICE *dptr = rq_devmap[uptr->cnum];
+uint32 dt = GET_DTYPE (uptr->flags);
+int32 u = rq_unit_index (uptr);
+RQ_USNAP *s;
+t_stat r;
+
+if (!rq_is_rc25_type (dt)) {
+    uptr->unit_plug = plug;
+    return SCPE_OK;
+    }
+if ((plug & 1) != (uint32) (dt == RCF25_DTYPE))
+    return sim_messagef (SCPE_ARG, "%s: the %s needs an %s unit number\n", sim_uname (uptr),
+                         drv_tab[dt].name, (dt == RC25_DTYPE) ? "even" : "odd");
+if ((s = rq_snap_take (dptr)) == NULL)
+    return SCPE_MEM;
+if ((dt == RC25_DTYPE) && ((u + 1) < (int32) dptr->numunits - 2))
+    r = rq_pair_plugs (dptr, uptr, &dptr->units[u + 1], plug);
+else if ((dt == RCF25_DTYPE) && (u > 0))
+    r = rq_pair_plugs (dptr, &dptr->units[u - 1], uptr, plug - 1);
+else {
+    uptr->unit_plug = plug;
+    r = SCPE_OK;
+    }
+if (r != SCPE_OK) {
+    free (s);
+    return r;
+    }
+return rq_snap_check (dptr, s);
+}
