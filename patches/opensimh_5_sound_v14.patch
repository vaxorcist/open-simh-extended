+t_stat hk_show_spindle (FILE *st, UNIT *uptr, int32 val, CONST void *desc)
+{
+if (!(uptr->flags & UNIT_ATT)) {
+    fprintf (st, "no pack");
+    return SCPE_OK;
+    }
+return sim_spindle_show (st, &hk_spindle[uptr - hk_dev.units]);
