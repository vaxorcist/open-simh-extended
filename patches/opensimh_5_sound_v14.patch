+#define HK_SEEK_EXP     0.69                            /* seek curve exponent */
+#define HK_REV_US       25000                           /* one revolution at 2400 rpm */
+#define HK_SECT_US      (HK_REV_US / HK_NUMSC)          /* one sector passes the head */
