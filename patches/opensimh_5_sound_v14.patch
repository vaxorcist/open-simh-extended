+n = (void (**) (t_bool)) realloc ((void *) snd_runhooks, (snd_n_runhooks + 1) * sizeof (*n));
+if (n == NULL)
+    return;
+snd_runhooks = n;
+snd_runhooks[snd_n_runhooks++] = fn;
