--- /dev/null
+++ b/sim_sound.c
@@ -0,0 +1,4091 @@
+/* sim_sound.c: common sound support for all simulators
+
+   Copyright (c) 2026, Ulli (vaxorcist)
+
+   Permission is hereby granted, free of charge, to any person obtaining a
