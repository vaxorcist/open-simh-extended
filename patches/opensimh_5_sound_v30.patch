+if ((tssr & TSSR_NBA) || !(wchopt & WCH_EAI))           /* attn msg? */
+    return;
+if (ts_ownm) {                                          /* own msg buf? */
+    ts_endcmd_now (TC1, 0, MSG_MATN | MSG_CATN);        /* send attn */
+    SET_INT (TS);                                       /* set interrupt */
+    ts_qatn = 0;                                        /* don't queue */
+    }
+else ts_qatn = 1;                                       /* else queue */
