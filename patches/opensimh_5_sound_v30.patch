+    sim_debug (RLDEB_OPS, &rl_dev, ">>RL%d spin up\n", (int32) (uptr - rl_dev.units));
+    uptr->STAT = (uptr->STAT & ~(RLDS_M_STATE | RLDS_HDO)) | RLDS_SPIN | RLDS_BHO;
+    sim_spindle_start (&rl_spindle[uptr - rl_dev.units]);
