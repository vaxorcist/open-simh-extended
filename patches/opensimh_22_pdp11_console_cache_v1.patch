From 152182d564455bb911365e520b83b09afda0032e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 16:20:28 +0100
Subject: [PATCH] PDP-11: cache hit/miss register, console DL11 maintenance
 loopback and RESET

Found running DEC's M9312 console/diagnostic ROMs (known issues 106-108,
110):
- the 11/44, 11/60 and 11/70 hit/miss register reads 077 (every reference
  a hit) unless CCR bits 2 and 3 force misses in both cache halves; it
  read 0, so the 23-616F1 diagnostic ROM halted in its cache test;
- the console DL11 maintenance bit (XCSR bit 2) is writable; while it is
  set a transmitted character goes to the receiver instead of the
  terminal (the 11/24 ROM 23-774F1 waited for ever in its console test);
- a reset (bus INIT) lets the character being sent go out instead of
  dropping it (the last character before a RESET was lost);
- SET TTI DEBUG=DAT no longer aborts the simulator on a NUL byte.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SuavtcpUxEC2vXhit3JaAg
---
 PDP11/pdp11_cpumod.c | 24 +++++++++++++++++++++---
 PDP11/pdp11_stddev.c | 34 +++++++++++++++++++++++++++++-----
 2 files changed, 50 insertions(+), 8 deletions(-)

diff --git a/PDP11/pdp11_cpumod.c b/PDP11/pdp11_cpumod.c
index d50063be..e64aefb6 100644
--- a/PDP11/pdp11_cpumod.c
+++ b/PDP11/pdp11_cpumod.c
@@ -25,6 +25,8 @@
 
    system       PDP-11 model-specific registers
 
+   22-Nov-26    Claude  11/44, 11/60, 11/70 hit/miss register reports cache hits
+                        unless both cache halves are forced to miss
    19-Nov-22    RMS     Fixed byte access errors in PIRQ, STKLIM, CDR (Walter Mueller)
    15-Sep-20    RMS     Fixed problem in KDJ11E programmable clock (Paul Koning)
    04-Mar-16    RMS     Fixed maximum memory sizes to exclude IO page
@@ -390,6 +392,22 @@ else R[reg] = (R[reg] & ~0377) | data;
 return SCPE_OK;
 }
 
+/* Hit/miss register of the 11/44, 11/60 and 11/70 caches
+
+   The real register records the last six memory references, a 1 for a
+   cache hit (bit 0 the most recent).  SIMH has no cache model; reporting
+   misses for ever (the old fixed 0) fails DEC's diagnostics, e.g. the
+   M9312 ROM 23-616F1 halts in its cache test.  So every reference counts
+   as a hit while the cache can hit at all, i.e. unless CCR bits 2 and 3
+   force misses in both halves (groups) of the cache.  The value is kept
+   in HITMISS so that EXAMINE shows what the program saw last. */
+
+static int32 cpu_hitmiss (void)
+{
+HITMISS = ((CCR & 014) == 014)? 0: 077;
+return HITMISS;
+}
+
 /* CPU control registers - 11/24 */
 
 t_stat CPU24_rd (int32 *data, int32 pa, int32 access)
@@ -435,7 +453,7 @@ switch ((pa >> 1) & 017) {                              /* decode pa<4:1> */
         return SCPE_OK;
 
     case 005:                                           /* Hit/miss */
-        *data = HITMISS;
+        *data = cpu_hitmiss ();
         return SCPE_OK;
 
     case 006:                                           /* CDR */
@@ -556,7 +574,7 @@ switch ((pa >> 1) & 017) {                              /* decode pa<4:1> */
         return SCPE_OK;
 
     case 005:                                           /* Hit/miss */
-        *data = HITMISS;
+        *data = cpu_hitmiss ();
         return SCPE_OK;
 
     case 013:                                           /* CPUERR */
@@ -639,7 +657,7 @@ switch ((pa >> 1) & 017) {                              /* decode pa<4:1> */
         return SCPE_OK;
 
     case 005:                                           /* Hit/miss */
-        *data = HITMISS;
+        *data = cpu_hitmiss ();
         return SCPE_OK;
 
     case 010:                                           /* low size */
diff --git a/PDP11/pdp11_stddev.c b/PDP11/pdp11_stddev.c
index ce156c57..bc9fe4aa 100644
--- a/PDP11/pdp11_stddev.c
+++ b/PDP11/pdp11_stddev.c
@@ -26,6 +26,9 @@
    tti,tto      DL11 terminal input/output
    clk          KW11L (and other) line frequency clock
 
+   22-Nov-26    Claude  Console DL11 maintenance loopback (XCSR<2>); a reset
+                        lets the character being sent go out; the TTI debug
+                        line prints non-printable characters as '.'
    30-Dec-15    RMS     Added NOBEVENT support
    18-Apr-12    RMS     Modified to use clock coscheduling
    20-May-08    RMS     Standardized clock delay at 1mips
@@ -69,8 +72,9 @@
 
 #define TTICSR_IMP      (CSR_DONE + CSR_IE)             /* terminal input */
 #define TTICSR_RW       (CSR_IE)
-#define TTOCSR_IMP      (CSR_DONE + CSR_IE)             /* terminal output */
-#define TTOCSR_RW       (CSR_IE)
+#define TTOCSR_MAINT    0000004                         /* DL11 maintenance */
+#define TTOCSR_IMP      (CSR_DONE + CSR_IE + TTOCSR_MAINT)  /* terminal output */
+#define TTOCSR_RW       (CSR_IE + TTOCSR_MAINT)
 #define CLKCSR_IMP      (CSR_DONE + CSR_IE)             /* real-time clock */
 #define CLKCSR_RW       (CSR_IE)
 #define CLK_DELAY       16667
@@ -369,7 +373,10 @@ else {
 if ((c = sim_poll_kbd ()) < SCPE_KFLAG) /* no char or error? */
     return c;
 #endif
-sim_debug (DBG_DATA, &tti_dev, "tti_svc() - Received data: 0x%02X '%c'\n", c & ~SCPE_KFLAG, c & ~SCPE_KFLAG);
+if (tto_csr & TTOCSR_MAINT)                 /* maintenance loopback: */
+    return SCPE_OK;                         /* the terminal is disconnected */
+sim_debug (DBG_DATA, &tti_dev, "tti_svc() - Received data: 0x%02X '%c'\n", c & ~SCPE_KFLAG,
+           (((c & 0177) >= 040) && ((c & 0177) < 0177))? (c & 0177): '.');  /* no NUL: sim_debug aborts */
 if (c & SCPE_BREAK)                         /* break? */
     uptr->buf = 0;
 else
@@ -445,8 +452,14 @@ t_stat tto_svc (UNIT *uptr)
 int32 c;
 t_stat r;
 
-c = sim_tt_outcvt (uptr->buf, TT_GET_MODE (uptr->flags));
-if (c >= 0) {
+if (tto_csr & TTOCSR_MAINT) {                           /* maintenance loopback: */
+    tti_unit.buf = uptr->buf & 0377;                    /* the character goes */
+    tti_buftime = sim_os_msec ();                       /* to the receiver */
+    tti_csr = tti_csr | CSR_DONE;
+    if (tti_csr & CSR_IE)
+        SET_INT (TTI);
+    }
+else if ((c = sim_tt_outcvt (uptr->buf, TT_GET_MODE (uptr->flags))) >= 0) {
     if ((r = sim_putchar_s (c)) != SCPE_OK) {           /* output; error? */
         sim_activate (uptr, uptr->wait);                /* try again */
         return ((r == SCPE_STALL)? SCPE_OK: r);         /* !stall? report */
@@ -463,6 +476,17 @@ return SCPE_OK;
 
 t_stat tto_reset (DEVICE *dptr)
 {
+int32 c;
+
+if (sim_is_active (&tto_unit)) {                        /* character being sent? */
+    sim_cancel (&tto_unit);                             /* a DL11 finishes it, */
+    if (!(tto_csr & TTOCSR_MAINT)) {                    /* INIT clears only the */
+        c = sim_tt_outcvt (tto_unit.buf, TT_GET_MODE (tto_unit.flags)); /* registers */
+        if (c >= 0)
+            sim_putchar (c);
+        tto_unit.pos = tto_unit.pos + 1;
+        }
+    }
 tto_unit.buf = 0;
 tto_csr = CSR_DONE;
 CLR_INT (TTO);
-- 
