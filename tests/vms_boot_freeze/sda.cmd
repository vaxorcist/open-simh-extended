# open-simh-extended/tests/vms_boot_freeze/sda.cmd  v1
# Known issue 97: on a healthy node, get the addresses and offsets needed to
# read the VMS scheduler state of a frozen node with SIMH examine commands
# (the same system image, so the same addresses).
OPEN/WRITE F SYS$LOGIN:SDA.INP
WRITE F "READ SYS$SYSTEM:SYSDEF.STB"
WRITE F "EVALUATE EXE$GQ_SYSTIME"
WRITE F "EVALUATE SCH$GL_PCBVEC"
WRITE F "EVALUATE SCH$GL_MAXPIX"
WRITE F "EVALUATE EXE$GQ_1ST_TIME"
WRITE F "EVALUATE EXE$GL_TQFL"
WRITE F "EVALUATE PCB$W_STATE"
WRITE F "EVALUATE PCB$T_LNAME"
WRITE F "EVALUATE PCB$L_EFWM"
WRITE F "EVALUATE PCB$L_WEFC"
WRITE F "EVALUATE PCB$L_PID"
WRITE F "EVALUATE PCB$L_EFCS"
WRITE F "EVALUATE PCB$L_STS"
WRITE F "EVALUATE SCH$C_LEF"
WRITE F "EVALUATE SCH$C_HIB"
WRITE F "EVALUATE SCH$C_MWAIT"
WRITE F "SHOW SUMMARY"
WRITE F "EXIT"
CLOSE F
DEFINE/USER SYS$INPUT SYS$LOGIN:SDA.INP
ANALYZE/SYSTEM
